---
// 산업 상세 페이지 본문. 한국어(/industries/[slug])와 영어(/en/industries/[slug])가
// 이 컴포넌트를 공유한다. 로케일별로 다른 것은 아래 T 사전과 데이터뿐이다.
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../styles/industry.css';
import type { IndustryData } from '../data/industries/types';

interface Props {
  ind: IndustryData;
  lang?: 'ko' | 'en';
}
const { ind, lang = 'ko' } = Astro.props;

const T = {
  ko: {
    crumbAria: '위치', industries: 'Industries', industriesHref: '/#industries',
    cta: '데모 신청하기', contactHref: '/contact', secondary: '제품 살펴보기 →', secondaryHref: '/#teams',
    problem: '문제', approach: '접근', outcome: '성과',
  },
  en: {
    crumbAria: 'Breadcrumb', industries: 'Industries', industriesHref: '/en#industries',
    cta: 'Request a demo', contactHref: '/en/contact', secondary: 'Explore the product →', secondaryHref: '/en#teams',
    problem: 'Problem', approach: 'Approach', outcome: 'Outcome',
  },
}[lang];

const canonical = lang === 'en' ? `/en/industries/${ind.slug}` : `/industries/${ind.slug}`;
// ko/en 양쪽이 모두 존재하는 페이지라 hreflang을 출력한다.
const alternates = [
  { lang: 'ko', href: `/industries/${ind.slug}` },
  { lang: 'en', href: `/en/industries/${ind.slug}` },
];
const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Industries', item: `${SITE}${T.industriesHref}` },
    { '@type': 'ListItem', position: 2, name: ind.name, item: `${SITE}${canonical}` },
  ],
};
const lines = (s: string) => s.split('\n');
---
<BaseLayout title={ind.pageTitle} description={ind.description} canonical={canonical} alternates={alternates} ogImage={ind.seo?.ogImage} ogTitle={ind.seo?.ogTitle} jsonLd={jsonLd}>
  <Nav />
  <main class="ind">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <nav class="ind-crumb" aria-label={T.crumbAria}><a href={T.industriesHref}>{T.industries}</a><span>›</span><span>{ind.name}</span></nav>
        <p class="ind-eyebrow">{ind.hero.eyebrow}</p>
        <h1>{lines(ind.hero.title).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h1>
        <p class="ind-lede">{ind.hero.lede}</p>
        <div class="ind-hero-actions">
          <a href={T.contactHref} class="ind-btn-primary">{T.cta}</a>
          <a href={T.secondaryHref} class="ind-btn-ghost">{T.secondary}</a>
        </div>
      </div>
    </section>

    <!-- CHALLENGES -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>{ind.challenges.title}</h2>
          {ind.challenges.subtitle && <p>{ind.challenges.subtitle}</p>}
        </header>
        <div class="ind-grid ind-grid-2">
          {ind.challenges.items.map((c) => (
            <div class="ind-card">
              <h3>{c.title}</h3>
              <p>{c.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- USE CASES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head">
          <span class="ind-badge">USE CASES</span>
          <h2>{ind.useCases.title}</h2>
          {ind.useCases.subtitle && <p>{ind.useCases.subtitle}</p>}
        </header>
        <div class="ind-usecases">
          {ind.useCases.items.map((u, i) => (
            <article class="ind-usecase">
              <div class="ind-usecase-num">{String(i + 1).padStart(2, '0')}</div>
              <div class="ind-usecase-body">
                <h3>{u.title}</h3>
                <dl>
                  <div><dt>{T.problem}</dt><dd>{u.problem}</dd></div>
                  <div><dt>{T.approach}</dt><dd>{u.approach}</dd></div>
                  <div><dt>{T.outcome}</dt><dd class="ind-outcome">{u.outcome}</dd></div>
                </dl>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ARCHITECTURE -->
    <section class="ind-section ind-dark">
      <div class="ind-container">
        <header class="ind-head ind-head-light">
          <h2>{ind.architecture.title}</h2>
          {ind.architecture.subtitle && <p>{ind.architecture.subtitle}</p>}
        </header>
        <div class="ind-flow">
          {ind.architecture.steps.map((s, i) => (
            <>
              {i > 0 && <div class="ind-flow-arrow" aria-hidden="true">→</div>}
              <div class="ind-flow-step">
                <div class="ind-flow-label">{s.label}</div>
                <div class="ind-flow-detail">{s.detail}</div>
              </div>
            </>
          ))}
        </div>
        {ind.architecture.note && <p class="ind-flow-note">{ind.architecture.note}</p>}
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <span class="ind-badge">BENEFITS</span>
          <h2>{ind.benefits.title}</h2>
          {ind.benefits.subtitle && <p>{ind.benefits.subtitle}</p>}
        </header>
        <div class="ind-grid ind-grid-3">
          {ind.benefits.items.map((b) => (
            <div class="ind-card">
              <h3>{b.title}</h3>
              <p>{b.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- INTEGRATIONS -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head">
          <h2>{ind.integrations.title}</h2>
          {ind.integrations.subtitle && <p>{ind.integrations.subtitle}</p>}
        </header>
        <div class="ind-systems">
          {ind.integrations.systems.map((s) => <span class="ind-system">{s}</span>)}
        </div>
        {ind.integrations.note && <p class="ind-systems-note">{ind.integrations.note}</p>}
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta">
      <div class="ind-container">
        <h2>{lines(ind.cta.title).map((l, i) => (<>{i > 0 && <br />}{l}</>))}</h2>
        <a href={T.contactHref} class="ind-btn-primary ind-btn-lg">{ind.cta.buttonLabel}</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
