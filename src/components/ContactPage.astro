---
// 문의 페이지 본문. 한국어(/contact)와 영어(/en/contact)가 이 컴포넌트를 공유한다.
// 인라인 스크립트가 쓰는 문구는 define:vars 대신 data 속성으로 넘긴다(전역 함수 보존 규칙).
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/contact.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  lang?: 'ko' | 'en';
}
const { lang = 'ko' } = Astro.props;

const T = {
  ko: {
    title: '문의하기 | Refinery',
    description: 'Refinery 도입 문의, 데모 신청은 여기서 진행해주세요. 담당자가 빠르게 연락드립니다.',
    canonical: '/contact',
    heroTitle: '귀사의 현장에 맞는 답을<br>Refinery팀이<br class="contact-title-mobile-br"> 함께 찾아드립니다.',
    subject: 'Refinery 웹사이트 문의',
    fromName: 'Refinery 웹사이트 문의하기',
    company: '회사명', name: '성함', email: '이메일', phone: '연락처',
    position: '직책', industry: '산업 분야', message: '문의 내용',
    selectPlaceholder: '선택해주세요',
    industries: ['에너지 · 유틸리티', '정유 · 가스', '데이터센터', '철강', '화학 · 정밀화학', '물류', '환경', '기타'],
    phDesktop: '궁금하신 점이나 현재 겪고 계신 현장의 어려움을 자유롭게 남겨주세요.',
    phMobile: '궁금하신 점이나 현재 겪고 계신 현장의 \n어려움을 자유롭게 남겨주세요.',
    submit: '문의 보내기',
    successTitle: '문의가 접수되었습니다',
    successBody: '담당자가 확인 후 1~2 영업일 내 연락드리겠습니다.',
    errorText: '전송 중 문제가 발생했습니다. 잠시 후 다시 시도해주세요.',
  },
  en: {
    title: 'Contact | Refinery',
    description: 'Get in touch about adopting Refinery or request a demo. We will get back to you quickly.',
    canonical: '/en/contact',
    heroTitle: 'Let’s find the answer that fits<br>your operation,<br class="contact-title-mobile-br"> together.',
    subject: 'Refinery website inquiry',
    fromName: 'Refinery website contact form',
    company: 'Company', name: 'Name', email: 'Email', phone: 'Phone',
    position: 'Role', industry: 'Industry', message: 'How can we help?',
    selectPlaceholder: 'Please select',
    industries: ['Energy & Utilities', 'Oil & Gas', 'Data centers', 'Steel', 'Chemicals', 'Logistics', 'Environment', 'Other'],
    phDesktop: 'Tell us what you would like to know, or what you are running into on site.',
    phMobile: 'Tell us what you would like to know, \nor what you are running into on site.',
    submit: 'Send inquiry',
    successTitle: 'Your inquiry has been received',
    successBody: 'We will review it and get back to you within one to two business days.',
    errorText: 'Something went wrong while sending. Please try again in a moment.',
  },
}[lang];
---
<BaseLayout
  title={T.title}
  description={T.description}
  canonical={T.canonical}
  robots="noindex, follow"
>

<Nav />

<!-- CONTACT HERO -->
<section id="contact-hero">
  <div class="container">
    <h2 set:html={T.heroTitle}></h2>
  </div>
</section>

<!-- CONTACT BODY -->
<section id="contact-body">
  <div class="container">
    <div class="contact-layout">

      <!-- LEFT: info (문의 접수 후 절차 삭제됨, 자리만 유지) -->
      <div class="contact-info-list"></div>

      <!-- RIGHT: form -->
      <div class="contact-form-card">
        <form id="contactForm" data-error-text={T.errorText}>
          <input type="hidden" name="access_key" value="c719bd17-006a-44c6-8982-7d281c1f03a7">
          <input type="hidden" name="subject" value={T.subject}>
          <input type="hidden" name="from_name" value={T.fromName}>
          {/* 스팸 방어용 honeypot — 사람에게는 보이지 않는다 */}
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off">
          <div class="form-row">
            <div class="form-group">
              <label>{T.company}<span class="req">*</span></label>
              <input type="text" name="company" required>
            </div>
            <div class="form-group">
              <label>{T.name}<span class="req">*</span></label>
              <input type="text" name="name" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>{T.email}<span class="req">*</span></label>
              <input type="email" name="email" required>
            </div>
            <div class="form-group">
              <label>{T.phone}<span class="req">*</span></label>
              <input type="tel" name="phone" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>{T.position}</label>
              <input type="text" name="position">
            </div>
            <div class="form-group">
              <label>{T.industry}</label>
              <select name="industry">
                <option value="">{T.selectPlaceholder}</option>
                {T.industries.map((i) => <option>{i}</option>)}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>{T.message}</label>
            <textarea
              id="inquiryTextarea"
              name="message"
              data-ph-desktop={T.phDesktop}
              data-ph-mobile={T.phMobile}
            ></textarea>
          </div>
          <script is:inline>
            (function() {
              var ta = document.getElementById('inquiryTextarea');
              if (!ta) return;
              function updatePlaceholder() {
                var key = window.innerWidth <= 900 ? 'phMobile' : 'phDesktop';
                ta.placeholder = ta.dataset[key] || '';
              }
              updatePlaceholder();
              window.addEventListener('resize', updatePlaceholder);
            })();
          </script>
          <button type="submit" class="form-submit" id="contactSubmitBtn" disabled>{T.submit}</button>
        </form>
        <div class="form-success" id="formSuccess">
          <i class="ph ph-check-circle"></i>
          <h3>{T.successTitle}</h3>
          <p>{T.successBody}</p>
        </div>
      </div>

    </div>
  </div>
</section>

<Footer />

<script is:inline>
  (function() {
    var form = document.getElementById('contactForm');
    var submitBtn = document.getElementById('contactSubmitBtn');

    function updateSubmitState() {
      submitBtn.disabled = !form.checkValidity();
    }
    updateSubmitState();
    form.addEventListener('input', updateSubmitState);
    form.addEventListener('change', updateSubmitState);

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      submitBtn.disabled = true;
      var formData = new FormData(form);
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: formData
      }).then(function(res) { return res.json(); }).then(function(data) {
        if (typeof mixpanel !== 'undefined') mixpanel.track('Contact Form Submitted', { source: 'contact_page' });
        form.style.display = 'none';
        document.getElementById('formSuccess').classList.add('show');
      }).catch(function() {
        submitBtn.disabled = false;
        alert(form.dataset.errorText);
      });
    });
  })();
</script>

</BaseLayout>
