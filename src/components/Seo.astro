---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  robots?: string;
  jsonLd?: unknown;
  /** hreflang 대체 링크. 로케일별 페이지가 모두 존재할 때만 전달(없으면 미출력). */
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = '/og-image.png',
  ogType = 'website',
  robots = 'index, follow',
  jsonLd,
  alternates,
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
// hreflang: x-default는 기본 로케일(ko)로.
const hreflangs = alternates?.map((a) => ({
  hreflang: a.lang,
  href: new URL(a.href, Astro.site).href,
}));
const ogImageURL = new URL(ogImage, Astro.site);
const _ogTitle = ogTitle ?? title;
const _ogDesc = ogDescription ?? description;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalURL} />
{hreflangs && (
  <>
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    <link rel="alternate" hreflang="x-default" href={hreflangs[0].href} />
  </>
)}

<meta property="og:title" content={_ogTitle} />
<meta property="og:description" content={_ogDesc} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="Refinery" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={_ogTitle} />
<meta name="twitter:description" content={_ogDesc} />
<meta name="twitter:image" content={ogImageURL} />

{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
