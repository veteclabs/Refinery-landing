---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';

const SITE = 'https://refinery-ai-platform.vercel.app';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: '회사 소개 — Refinery',
  url: `${SITE}/company`,
  publisher: {
    '@type': 'Organization',
    name: 'Refinery',
    url: `${SITE}/`,
    logo: `${SITE}/logo_Refinery_symbol.svg`,
  },
};

// ⚠️ 회사 세부 사실(설립연도·조직 규모·수상 등)은 실제 정보로 확인·보완 필요.
const principles = [
  { title: '현장에서 출발합니다', description: '이론이 아니라 실제 산업 현장의 문제에서 시작합니다. 30년 넘게 현장에서 확인한 과제가 제품의 기준입니다.' },
  { title: '기존을 걷어내지 않습니다', description: '이미 쓰는 SCADA·MES·ERP를 대체하지 않고, 그 위에 통합 지능 레이어로 얹혀 함께 일합니다.' },
  { title: '데이터에 의미를 부여합니다', description: '흩어진 숫자를 온톨로지로 연결해 맥락을 만들고, AI가 근거를 들어 설명하게 합니다.' },
];
const strengths = [
  { title: '현장에서 검증된 경험', description: '발전·제조·에너지 등 산업 현장에서 쌓은 30년+의 경험을 솔루션에 녹였습니다.' },
  { title: '다양한 시스템을 하나로', description: '흩어진 설비·시스템·문서를 통합 솔루션으로 연결해 온 노하우가 제품의 뿌리입니다.' },
  { title: 'AI로 진화하는 운영', description: '축적된 현장 지식 위에 AI 에이전트를 더해, 데이터가 스스로 의사결정을 돕게 만듭니다.' },
];
---
<BaseLayout
  title="회사 소개 — 30년 현장 경험을 통합 솔루션으로 | Refinery"
  description="Refinery는 VETEC이 30년 넘게 산업 현장에서 쌓은 경험을 토대로 만들었습니다. 흩어진 시스템과 데이터를 하나의 통합 지능으로 잇습니다."
  canonical="/company"
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ind">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <nav class="ind-crumb" aria-label="위치"><a href="/">Home</a><span>›</span><span>회사 소개</span></nav>
        <p class="ind-eyebrow">OUR STORY</p>
        <h1>30년 산업 현장의 경험을<br>하나의 솔루션으로</h1>
        <p class="ind-lede">Refinery는 <strong>VETEC</strong>이 30년 넘게 산업 현장에서 쌓아 온 경험을 토대로 만들었습니다. 현장에서 반복해 마주친 문제를, 흩어진 시스템과 데이터를 하나로 잇는 통합 지능으로 풀어냅니다.</p>
        <div class="ind-hero-actions">
          <a href="/contact" class="ind-btn-primary">문의하기</a>
          <a href="/#platform" class="ind-btn-ghost">플랫폼 살펴보기 →</a>
        </div>
      </div>
    </section>

    <!-- STORY -->
    <section class="ind-section">
      <div class="ind-container">
        <div class="cmp-story">
          <header class="ind-head" style="margin-bottom:24px;">
            <span class="ind-badge">왜 Refinery인가</span>
            <h2>현장을 오래 본 사람이 만든 솔루션</h2>
          </header>
          <div class="cmp-prose">
            <p>산업 현장에는 데이터가 부족하지 않습니다. 오히려 SCADA·MES·ERP·센서·문서에 <strong>너무 흩어져</strong> 있어, 정작 판단이 필요한 순간에 쓰이지 못합니다. VETEC은 30년 넘게 발전·제조·에너지 현장에서 이 문제를 반복해서 목격했습니다.</p>
            <p>여러 설비와 시스템을 이어 붙이고, 흩어진 데이터를 하나로 모아 온 경험 — 그 오랜 현장 노하우를 제품으로 녹여낸 것이 Refinery입니다. 기존 시스템을 걷어내지 않고 그 위에 <strong>통합 지능 레이어</strong>로 올라가, 데이터에 의미를 부여하고 AI가 근거를 들어 의사결정을 돕게 합니다.</p>
            <p>우리는 화려한 기술 데모가 아니라, 현장에서 실제로 통하는 방식을 만듭니다.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="ind-section ind-dark cmp-stats-sec">
      <div class="ind-container">
        <div class="cmp-stats">
          <div class="cmp-stat"><div class="cmp-stat-num">30년+</div><div class="cmp-stat-label">산업 현장 경험</div></div>
          <div class="cmp-stat"><div class="cmp-stat-num">9개 산업</div><div class="cmp-stat-label">에너지·제조·물류·공공 등</div></div>
          <div class="cmp-stat"><div class="cmp-stat-num">기존 시스템 통합</div><div class="cmp-stat-label">SCADA·MES·ERP·PLC 연동</div></div>
        </div>
      </div>
    </section>

    <!-- STRENGTHS -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>우리가 잘하는 것</h2>
          <p>30년+ 현장 경험이 제품의 세 가지 뿌리가 됩니다.</p>
        </header>
        <div class="ind-grid ind-grid-3">
          {strengths.map((s) => (
            <div class="ind-card"><h3>{s.title}</h3><p>{s.description}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head">
          <span class="ind-badge">PRINCIPLES</span>
          <h2>우리가 일하는 원칙</h2>
        </header>
        <div class="ind-grid ind-grid-3">
          {principles.map((p) => (
            <div class="ind-card"><h3>{p.title}</h3><p>{p.description}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta">
      <div class="ind-container">
        <h2>현장의 문제를<br>Refinery 팀과 함께 풀어보세요.</h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .cmp-stats-sec { padding: 60px 0; }
  .cmp-stats { display: flex; justify-content: center; gap: clamp(32px, 6vw, 80px); flex-wrap: wrap; text-align: center; }
  .cmp-stat-num { font-size: clamp(26px, 3.6vw, 40px); font-weight: 700; color: #fff; letter-spacing: -0.02em; line-height: 1.1; }
  .cmp-stat-label { margin-top: 10px; font-size: 14px; color: #9aa4b0; }
  .cmp-story { max-width: 760px; }
  .cmp-prose p { font-size: 17px; line-height: 1.75; color: #2b3644; }
  .cmp-prose p + p { margin-top: 18px; }
  .cmp-prose strong { color: var(--text); font-weight: 650; }
</style>
