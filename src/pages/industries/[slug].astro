---
// 본문은 IndustryPage 컴포넌트가 렌더한다(영어 /en/industries/[slug]와 공유).
import IndustryPage from '../../components/IndustryPage.astro';
import { industries } from '../../data/industries';

export function getStaticPaths() {
  return industries.map((ind) => ({ params: { slug: ind.slug }, props: { ind } }));
}

const { ind } = Astro.props;
---
<IndustryPage ind={ind} lang="ko" />
