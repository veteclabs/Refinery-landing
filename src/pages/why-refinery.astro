---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';

const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '왜 Refinery인가 | Refinery',
  url: `${SITE}/why-refinery`,
  isPartOf: { '@type': 'WebSite', name: 'Refinery', url: `${SITE}/` },
};

// 선택 이유 3 — 전부 1차 사실(현장 엔지니어·도입 방식·통합 지능). 미확인 수치 없음.
const values = [
  { icon: 'ph-hard-hat', title: '현장을 아는 팀이 만듭니다', desc: '개발자뿐 아니라 발전·제조·에너지 현장을 직접 뛴 현장 엔지니어가 한 팀. 문제를 자료가 아니라 현장의 맥락에서 정의합니다.' },
  { icon: 'ph-stack', title: '얹거나, 템플릿으로 시작하거나', desc: '이미 SCADA·MES·ERP를 쓰고 있으면 걷어내지 않고 그 위에 통합 지능 레이어를 얹습니다. 시스템이 없는 현장은 30년 경험으로 다져진 템플릿(예: 에너지경영시스템)에서 바로 시작합니다.' },
  { icon: 'ph-brain', title: '시계열을 넘어, 하나의 지능', desc: '센서 시계열뿐 아니라 설비·문서·이력까지 온톨로지로 엮어, AI가 근거를 들어 의사결정을 돕습니다.' },
];

// 기능 스토리 3 — 통합 / AI 에이전트 / 자동화
const stories = [
  {
    icon: 'ph-graph',
    eyebrow: '통합 · 온톨로지',
    title: '흩어진 데이터를 하나의 지식으로',
    points: [
      'SCADA·MES·ERP·센서·문서에 흩어진 데이터를 한곳에 모읍니다.',
      '온톨로지로 "무엇에 대한 데이터인지" 의미를 부여합니다.',
      '숫자와 기록이 맥락을 얻어 판단에 쓰입니다.',
    ],
  },
  {
    icon: 'ph-chat-circle-dots',
    eyebrow: 'AI 에이전트',
    title: '묻고 답하는 현장',
    points: [
      '궁금한 점을 물어보면 데이터를 근거로 답합니다.',
      '원인을 추론하고 다음 조치까지 제안합니다.',
      '답변의 근거가 된 데이터 출처를 함께 제시합니다.',
    ],
  },
  {
    icon: 'ph-gear-six',
    eyebrow: '자동화 · 워크플로우',
    title: '사람 없이도 돌아가는 운영',
    points: [
      '승인이 필요한 상황과 자동 처리할 상황을 대화로 정합니다.',
      '분석 결과가 보고서·알람·워크플로우 실행까지 이어집니다.',
      '반복 업무는 사람 손 없이 자동으로 처리됩니다.',
    ],
  },
];

const capabilityGroups = [
  { title: '데이터', items: ['온톨로지', '통합 대시보드', '파이프라인', '시계열 분석', '문서 지식화', '기존 시스템 연동'] },
  { title: '지능', items: ['AI 에이전트', '이상 감지 · 알람', '예지보전', '품질 예측', '에너지 최적화'] },
  { title: '운영', items: ['자동화 · 워크플로우', '리포트 자동화', 'ESG 리포트'] },
  { title: '신뢰', items: ['온프레미스 배포', '권한 · 암호화'] },
];

const industries = [
  '에너지 · 유틸리티', '데이터센터', '정유 · 가스', '철강',
  '화학 · 정밀화학', '물류', '환경',
];
---
<BaseLayout
  title="왜 Refinery인가 · 현장을 아는 팀이 만든 산업 AI | Refinery"
  description="흩어진 현장 데이터를 하나의 지식으로 잇고, AI가 근거를 들어 의사결정을 돕습니다. 기존 위에 얹거나 없으면 새로 구축해, 하나의 플랫폼으로 현장을 지능화합니다."
  canonical="/why-refinery"
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ind">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <nav class="ind-crumb" aria-label="위치"><a href="/">Home</a><span>›</span><span>왜 Refinery인가</span></nav>
        <p class="ind-eyebrow">WHY REFINERY</p>
        <h1>하나의 플랫폼으로<br>현장을 지능화합니다</h1>
        <p class="ind-lede">데이터 수집부터 온톨로지, AI 분석, 예측, 자동 실행까지, 흩어진 현장을 하나의 통합 지능으로 잇습니다. 기존 시스템 위에 얹거나, 없으면 처음부터 새로 세웁니다.</p>
        <div class="ind-hero-actions">
          <a href="/contact" class="ind-btn-primary">문의하기</a>
          <a href="/#platform" class="ind-btn-ghost">플랫폼 살펴보기 →</a>
        </div>
      </div>
    </section>

    <!-- VALUES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head">
          <span class="ind-badge">WHY</span>
          <h2>왜 Refinery를 선택하나</h2>
        </header>
        <div class="wr-values">
          {values.map((v, i) => (
            <div class="wr-value">
              <div class="wr-value-top">
                <span class="wr-value-n">{String(i + 1).padStart(2, '0')}</span>
                <i class={`ph ${v.icon} wr-value-ic`} aria-hidden="true"></i>
              </div>
              <h3>{v.title}</h3>
              <p>{v.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- STORY BLOCKS -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <h2>한 플랫폼 안에서 이어지는 흐름</h2>
          <p>모으고 → 의미를 붙이고 → 묻고 답하고 → 자동으로 실행합니다.</p>
        </header>
        <div class="wr-stories">
          {stories.map((s, i) => (
            <article class="wr-story">
              <div class="wr-story-step"><span>{String(i + 1).padStart(2, '0')}</span></div>
              <div class="wr-story-body">
                <p class="wr-story-eyebrow">{s.eyebrow}</p>
                <h3>{s.title}</h3>
                <ul>
                  {s.points.map((p) => <li>{p}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="ind-section">
      <div class="ind-container">
        <header class="ind-head">
          <span class="ind-badge">ALL-IN-ONE</span>
          <h2>한 플랫폼에 담긴 기능</h2>
          <p>현장 운영에 필요한 기능이 하나의 플랫폼 안에 있습니다.</p>
        </header>
        <div class="wr-caps">
          {capabilityGroups.map((g) => (
            <div class="wr-cap-group">
              <h3 class="wr-cap-title">{g.title}</h3>
              <ul>
                {g.items.map((it) => <li><i class="ph ph-check" aria-hidden="true"></i>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- INDUSTRIES -->
    <section class="ind-section ind-dark">
      <div class="ind-container">
        <header class="ind-head">
          <h2 style="color:#fff;">산업을 가리지 않습니다</h2>
          <p style="color:#9aa4b0;">각 산업의 고유한 과제를 학습하고 해결합니다.</p>
        </header>
        <div class="wr-inds">
          {industries.map((n) => <span class="wr-ind">{n}</span>)}
        </div>
        <div style="text-align:center;margin-top:28px;">
          <a href="/industries/energy" class="ind-btn-ghost ind-btn-ghost-on-dark">에너지 산업 사례 보기 →</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta">
      <div class="ind-container">
        <h2>현장의 문제를<br>Refinery 팀과 함께 풀어보세요.</h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* 선택 이유 3 — 상단 룰 + 번호(카드 박스 없이 편집형) */
  .wr-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 44px; }
  .wr-value { padding-top: 20px; border-top: 2px solid #16202c; }
  .wr-value-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .wr-value-n { font-size: 13px; font-weight: 800; letter-spacing: .1em; color: #16202c; }
  .wr-value-ic { font-size: 22px; color: #aab4c0; }
  .wr-value h3 { font-size: 19px; font-weight: 700; letter-spacing: -0.02em; }
  .wr-value p { margin-top: 11px; font-size: 15px; line-height: 1.72; color: #47535f; }

  /* 기능 스토리 — 번호 흐름(카드 대신 구분선) */
  .wr-stories { display: grid; gap: 0; }
  .wr-story { display: flex; gap: 30px; align-items: flex-start; padding: 32px 0; border-top: 1px solid var(--border); }
  .wr-story:last-child { border-bottom: 1px solid var(--border); }
  .wr-story-step { flex: none; width: 60px; }
  .wr-story-step span { font-size: 32px; font-weight: 800; letter-spacing: -0.03em; color: #c9d5e0; line-height: 1; }
  .wr-story-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .08em; color: #4b86bf; text-transform: uppercase; }
  .wr-story h3 { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; margin: 7px 0 13px; }
  .wr-story ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .wr-story li { position: relative; padding-left: 20px; font-size: 15.5px; line-height: 1.62; color: #47535f; }
  .wr-story li::before { content: ''; position: absolute; left: 3px; top: 9px; width: 6px; height: 6px; border-radius: 50%; background: #b7c1cc; }

  /* 기능 — 주제별 그룹 리스트(박스 그리드 제거) */
  .wr-caps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px 28px; }
  .wr-cap-title { font-size: 13px; font-weight: 700; letter-spacing: .04em; color: #16202c; padding-bottom: 11px; border-bottom: 1px solid var(--border); margin-bottom: 14px; }
  .wr-cap-group ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .wr-cap-group li { display: flex; align-items: center; gap: 9px; font-size: 14.5px; color: #2b3644; }
  .wr-cap-group li i { color: #76a6d7; font-size: 15px; flex: none; }

  /* 산업 칩 */
  .wr-inds { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .wr-ind { font-size: 14px; color: #e6edf3; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 999px; padding: 8px 16px; }
  .ind-btn-ghost-on-dark { color: #cdd6df; border-color: rgba(255,255,255,0.28); }

  @media (max-width: 860px) {
    .wr-values { grid-template-columns: 1fr; gap: 30px; }
    .wr-caps { grid-template-columns: repeat(2, 1fr); gap: 28px 24px; }
    .wr-story { gap: 20px; padding: 26px 0; }
    .wr-story-step { width: 44px; }
    .wr-story-step span { font-size: 26px; }
  }
  @media (max-width: 520px) {
    .wr-caps { grid-template-columns: 1fr; }
  }
</style>
