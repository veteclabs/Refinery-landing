---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/industry.css';

// ⚠️ 초안(준비중). 실제 문서가 준비되면 각 카드에 href를 채우고 badge/soon 상태를 해제한다.
const groups = [
  {
    title: '시작하기',
    items: [
      { label: '빠른 시작', desc: '설치·초기 설정부터 첫 대시보드까지', ready: false },
      { label: '핵심 개념 한눈에', desc: '온톨로지·AI 에이전트·파이프라인·자동화', ready: false },
    ],
  },
  {
    title: '플랫폼 가이드',
    items: [
      { label: '데이터 연동', desc: 'SCADA·MES·ERP·센서, OPC-UA·Modbus 등 프로토콜', ready: false },
      { label: '온톨로지 설계', desc: '흩어진 데이터에 의미를 부여하는 구조', ready: false },
      { label: 'AI 에이전트', desc: '대화형 질의·근거 추론·다음 조치 제안', ready: false },
      { label: '자동화 · 워크플로우', desc: '승인/자동 처리 규칙을 대화로 설계', ready: false },
    ],
  },
  {
    title: '운영 · 확장',
    items: [
      { label: '배포 · 보안', desc: '온프레미스/클라우드, 권한·암호화·OT/IT 경계', ready: false },
      { label: 'API · 웹훅', desc: '외부 시스템과 연결하는 확장 인터페이스', ready: false },
    ],
  },
];
---
<BaseLayout
  title="문서 | Refinery"
  description="Refinery 제품 문서. 설치·연동·온톨로지·AI 에이전트·자동화·배포 가이드를 준비하고 있습니다."
  canonical="/docs"
  robots="noindex, follow"
>
  <Nav />
  <main class="ind">
    <!-- HERO -->
    <section class="ind-hero">
      <div class="ind-container">
        <nav class="ind-crumb" aria-label="위치"><a href="/">Home</a><span>›</span><span>문서</span></nav>
        <p class="ind-eyebrow">DOCS</p>
        <h1>제품 문서</h1>
        <p class="ind-lede">설치·연동부터 온톨로지·AI 에이전트·자동화·배포까지, Refinery를 현장에 적용하는 데 필요한 문서를 준비하고 있습니다.</p>
        <div class="doc-note">
          📘 문서를 정리하는 중입니다. 지금 필요한 자료가 있으시면 <a href="/contact">문의하기</a>로 요청해 주세요. 우선 안내드립니다.
        </div>
      </div>
    </section>

    <!-- CATEGORIES -->
    {groups.map((g) => (
      <section class="ind-section">
        <div class="ind-container">
          <header class="ind-head"><h2>{g.title}</h2></header>
          <div class="ind-grid ind-grid-3">
            {g.items.map((it) => (
              it.ready
                ? <a class="ind-card doc-card" href={it.href}><h3>{it.label}</h3><p>{it.desc}</p></a>
                : <div class="ind-card doc-card is-soon"><h3>{it.label}</h3><p>{it.desc}</p><span class="doc-soon">준비중</span></div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- RELATED -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head">
          <span class="ind-badge">먼저 둘러보기</span>
          <h2>문서가 준비되기 전에</h2>
          <p>블로그에서 현장 인사이트와 제품 소식을 먼저 만나보실 수 있습니다.</p>
        </header>
        <div class="ind-hero-actions" style="justify-content:center;">
          <a href="/blog" class="ind-btn-primary">블로그 보기</a>
          <a href="/#platform" class="ind-btn-ghost">플랫폼 살펴보기 →</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ind-cta">
      <div class="ind-container">
        <h2>필요한 문서를<br>바로 요청하세요.</h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .doc-note {
    margin-top: 22px; max-width: 640px;
    background: #f4f7fa; border: 1px solid #e3e7ec; border-radius: 12px;
    padding: 14px 18px; font-size: 14.5px; line-height: 1.6; color: #47535f;
  }
  .doc-note a { color: #4b86bf; text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }
  .doc-card { position: relative; }
  .doc-card.is-soon { opacity: 0.72; }
  .doc-soon {
    position: absolute; top: 16px; right: 16px;
    font-size: 11px; font-weight: 700; letter-spacing: .02em;
    color: #7e8a98; background: #eef1f4; border-radius: 999px; padding: 3px 9px;
  }
  a.doc-card { text-decoration: none; }
</style>
