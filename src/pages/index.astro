---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

// hreflang: 존재하는 로케일만(ko·en). ja 페이지 생성 후 추가.
const alternates = [
  { lang: 'ko', href: '/' },
  { lang: 'en', href: '/en' },
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Refinery",
  "url": "https://refinery.kr/",
  "logo": "https://refinery.kr/logo_Refinery_symbol.svg",
  "description": "산업 데이터의 복잡성을 정제하여 명료한 인사이트로. 수집부터 AI 분석, 예측, 자율 제어까지. 데이터 기반 의사결정이 가능한 조직을 만듭니다.",
  "sameAs": []
};

// FAQ 섹션과 동일한 Q&A → FAQPage 구조화 데이터(구글 리치 결과). 본문 FAQ와 함께 유지.
const faqItems = [
  { q: "가격은 어떻게 책정되나요?", a: "정책이 확정되는 대로 안내드립니다. 자세한 내용은 영업팀에 문의해 주세요." },
  { q: "도입까지 얼마나 걸리나요?", a: "PoC부터 전사 확장까지 현장 규모와 기존 시스템 복잡도에 따라 달라집니다. 정확한 일정은 상담을 통해 안내드립니다." },
  { q: "보안은 어떻게 보장되나요?", a: "전송 구간은 TLS 1.3, 저장 데이터는 AES-256으로 암호화하고, 조직별 데이터 격리(PostgreSQL RLS)와 RBAC·감사 로그를 적용합니다. 온프레미스 배포 옵션도 제공하며, 이 경우 데이터가 사내를 벗어나지 않습니다." },
  { q: "현장 데이터를 AI 학습에 사용하나요?", a: "아니오. 고객 데이터는 AI 모델 학습에 사용되지 않습니다. 각 고객의 데이터는 완전히 격리되어 관리됩니다." },
  { q: "기존 SCADA/MES/ERP는 어떻게 되나요?", a: "기존 시스템이 있으면 걷어내지 않고 그 위에 통합 지능 레이어로 얹혀 양방향 연동합니다. 시스템이 없는 현장은 30년 경험으로 만든 템플릿(예: 에너지경영시스템)에서 새로 구축합니다. 두 방식 모두 지원합니다." },
  { q: "어떤 언어를 지원하나요?", a: "인터페이스와 AI 에이전트의 답변은 현재 한국어로 제공됩니다. 영어 지원은 추후 확대할 예정입니다." },
  { q: "클라우드와 온프레미스 중 선택할 수 있나요?", a: "클라우드, 온프레미스, 하이브리드 모두 지원합니다. 보안 정책에 따라 유연하게 선택 가능합니다." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const jsonLd = [orgSchema, faqSchema];
---
<BaseLayout
  title="Refinery — Refining complexity into pure insight"
  ogTitle="Refinery"
  description="산업 데이터의 복잡성을 정제하여 명료한 인사이트로. 수집부터 AI 분석, 예측, 자율 제어까지. 데이터 기반 의사결정이 가능한 조직을 만듭니다."
  ogDescription="Refining complexity into pure insight"
  canonical="/"
  alternates={alternates}
  jsonLd={jsonLd}
>

<Nav />

<!-- HERO -->
<main id="main">
<section id="hero">
  <div class="container">
    <div class="hero-row">
      <div class="hero-text">
        <h1>Refinery <span class="hero-title-accent">Agentic AI</span></h1>
        <p>현장 곳곳에 흩어진 데이터와 문서를 하나의 산업 <br class="mobile-br">지식으로 연결합니다.<br>AI는 현장을 이해하고 예지보전부터 품질, 에너지, <br class="mobile-br">자율 운전까지 모든 운영 의사결정을 지원합니다.</p>
      </div>
      <div class="hero-actions">
        <a href="/contact" class="hero-demo-link" onclick="if(window.openContactDrawer){openContactDrawer();return false;}">
          데모 신청하기
          <svg width="20" height="20" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
        </a>
      </div>
    </div>
    <div class="hero-motion-placeholder">
      <iframe id="hero-agent-iframe" data-src="/agent-replay-demo" loading="lazy" scrolling="no" tabindex="-1" title="Refinery AI 에이전트 데모" style="display:block;border:none;position:absolute;top:0;left:0;transform-origin:top left;pointer-events:none;"></iframe>
        </div>

  </div>
  
  <script is:inline>
    (function() {
      var HERO_AGENT_W = 1440;
      var HERO_AGENT_H = 900;
      var HERO_MOBILE_CROP_LEFT = 283;  /* 좌측 세션 레일(.rail) 끝 지점 = 283px (agent-replay-demo 기준). 레일을 잘라 대화 본문만 확대 */
      var HERO_MOBILE_CROP_RIGHT = 1427; /* 대화 본문(.main) 우측 끝 = 1427px. 본문 전체를 보여준다 */
      function resizeHeroAgent() {
        var wrapper = document.querySelector('.hero-motion-placeholder');
        if (!wrapper) return;
        var w = wrapper.offsetWidth;
        var h = wrapper.offsetHeight;
        var isMobile = window.innerWidth <= 900;
        // 데스크탑: 폭 기준으로만 스케일링해 좌우/우측이 잘리지 않고 전체 화면이 그대로 보이도록 한다.
        // 모바일: 화면이 좁아 전체를 다 보여주면 글씨가 너무 작아지므로,
        // 좌측 세션 레일과 우측 여백/툴바 아이콘을 잘라내고 대화 본문 위주로 확대해서 보여준다.
        var effectiveW = isMobile ? (HERO_MOBILE_CROP_RIGHT - HERO_MOBILE_CROP_LEFT) : HERO_AGENT_W;
        var scale = w / effectiveW;
        var leftOffset = isMobile ? -(HERO_MOBILE_CROP_LEFT * scale) : 0;
        var scaledH = HERO_AGENT_H * scale;
        var topOffset = Math.max(0, (h - scaledH) / 2);
        var iframe = document.getElementById('hero-agent-iframe');
        if (iframe) {
          iframe.style.width = HERO_AGENT_W + 'px';
          iframe.style.height = HERO_AGENT_H + 'px';
          iframe.style.transform = 'scale(' + scale + ')';
          iframe.style.top = topOffset + 'px';
          iframe.style.left = leftOffset + 'px';
        }
      }
      window.resizeHeroAgent = resizeHeroAgent;
      window.addEventListener('load', resizeHeroAgent);
      window.addEventListener('resize', resizeHeroAgent);
      document.addEventListener('DOMContentLoaded', resizeHeroAgent);

      /* 성능: 무거운 데모 iframe(자체 JS·애니메이션)은 페이지가 인터랙티브해진 뒤(유휴 시점)
         로드해 초기 TBT/네트워크 부하를 줄인다. 로드 후 크기 재계산. */
      function loadHeroDemo() {
        var f = document.getElementById('hero-agent-iframe');
        if (f && !f.src && f.getAttribute('data-src')) {
          f.addEventListener('load', resizeHeroAgent);
          f.src = f.getAttribute('data-src');
        }
      }
      if ('requestIdleCallback' in window) {
        window.addEventListener('load', function () { requestIdleCallback(loadHeroDemo, { timeout: 1500 }); });
      } else {
        window.addEventListener('load', function () { setTimeout(loadHeroDemo, 200); });
      }

      /* 히어로 데모가 재생 완료된 뒤 화면 밖으로 나갔다가 다시 들어오면
         재생을 처음부터 다시 시작한다 (멈춰있는 화면처럼 보이지 않도록). */
      function initHeroReplay() {
        var heroSection = document.getElementById('hero');
        var iframe = document.getElementById('hero-agent-iframe');
        if (!heroSection || !iframe || !('IntersectionObserver' in window)) return;
        var hasLeft = false;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              if (hasLeft) {
                hasLeft = false;
                try {
                  iframe.contentWindow.postMessage({ type: 'refinery-hero-replay' }, '*');
                } catch (e) { /* 접근 불가 시 무시 */ }
              }
            } else {
              hasLeft = true;
            }
          });
        }, { threshold: 0.5 });
        observer.observe(heroSection);
      }
      window.addEventListener('load', initHeroReplay);
    })();
  </script>
  </section>

<!-- PLATFORM -->
<section id="platform" style="background:#111316;border-top:1px solid #E3E7EC;">
  <style is:global>
    #platform .section-header p {
      color: #959CA5;
    }
    #platform .platform-graphic-img {
      margin-top: 64px;
    }
    #platform .series-nav-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 48px;
    }
    #platform .series-progress {
      width: 120px;
      height: 3px;
      border-radius: 2px;
      background: #272B32;
      overflow: hidden;
    }
    #platform .series-progress-fill {
      height: 100%;
      width: 20%;
      background: var(--accent);
      border-radius: 2px;
      transition: width .35s cubic-bezier(0.22,1,0.36,1);
    }
    #platform .series-nav-btns {
      display: flex;
      gap: 10px;
    }
    #platform .series-nav-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid #272B32;
      background: #111316;
      color: #EDEEF0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
      padding: 0;
    }
    #platform .series-nav-btn:hover {
      background: var(--accent);
      border-color: var(--accent);
    }
    #platform .series-nav-btn:disabled {
      opacity: 0.35;
      cursor: default;
      background: #111316;
      border-color: #272B32;
    }
    /* 쉐브론 화살표는 기하학적으로는 중앙이지만, 뾰족한 끝과 벌어진 두 선의 무게중심이
       달라 눈으로 보면 한쪽으로 치우쳐 보인다 — 시각적으로 가운데처럼 보이도록 미세 보정 */
    #platform .series-prev svg {
      transform: translateX(-1px);
    }
    #platform .series-next svg {
      transform: translateX(1px);
    }
    #platform .series-viewport {
      overflow: hidden;
      margin: 16px 0 0;
      padding: 0 0 4px;
    }
    #platform .series-slider {
      display: flex;
      gap: 16px;
      transition: transform 0.45s cubic-bezier(0.22,1,0.36,1);
      will-change: transform;
    }
    #platform .series-card {
      flex: 0 0 300px;
      background: #111316;
      border: 1px solid #272B32;
      border-radius: var(--radius);
      padding: 24px;
    }
    #platform .series-icon {
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      margin-bottom: 80px;
    }
    #platform .series-icon svg {
      width: 26px;
      height: 26px;
    }
    #platform .series-icon i {
      font-size: 26px;
      line-height: 1;
    }
    #platform .series-card h3 {
      font-size: 16px;
      font-weight: 600;
      color: #EDEEF0;
      margin: 0 0 10px;
      line-height: 1.4;
    }
    #platform .series-tagline {
      font-size: 12px;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 1.2px;
      margin-bottom: 8px;
    }
    #platform .series-card:has(.series-tagline) .series-icon {
      margin-bottom: 52.8px;
    }
    #platform .series-en {
      color: #959CA5;
      font-weight: 400;
      font-size: 0.8em;
      display: block;
      margin-top: 2px;
    }
    #platform .series-quote {
      font-size: 13px;
      font-style: italic;
      color: var(--accent);
      margin: 0 0 10px;
      line-height: 1.55;
    }
    #platform .series-desc {
      font-size: 13px;
      color: #959CA5;
      line-height: 1.65;
      margin: 0;
    }
    @media (max-width: 900px) {
      #platform .platform-graphic-wrap {
        margin: 40px -24px 0;
        padding: 0 24px 6px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      #platform .platform-graphic-wrap::-webkit-scrollbar { display: none; }
      #platform .platform-graphic-img {
        margin-top: 0;
        width: auto;
        min-width: 680px;
        max-width: none;
      }
      #platform .series-viewport {
        margin: 16px 0 0;
        padding: 0 0 4px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      #platform .series-viewport::-webkit-scrollbar { display: none; }
      #platform .series-card {
        flex: 0 0 80vw;
        max-width: 300px;
        padding: 20px;
      }
      #platform .series-icon {
        margin-bottom: 56px;
      }
      #platform .series-card:has(.series-tagline) .series-icon {
        margin-bottom: 40px;
      }
    }
  </style>
  <script is:inline>
    (function() {
      function initSeriesSlider() {
        var viewport = document.querySelector('#platform .series-viewport');
        var slider = document.querySelector('#platform .series-slider');
        var prevBtn = document.querySelector('#platform .series-prev');
        var nextBtn = document.querySelector('#platform .series-next');
        if (!viewport || !slider || !prevBtn || !nextBtn) return;
        var index = 0;
        function cardStep() {
          var card = slider.querySelector('.series-card');
          if (!card) return 316;
          var gap = parseFloat(getComputedStyle(slider).columnGap || 16);
          return card.getBoundingClientRect().width + gap;
        }
        /* 좌우 잘리는 카드(peek)가 동일한 크기로 보이도록, 가운데 3장이 꽉 차고
           남는 여백만큼을 뷰포트 좌우 패딩(peek)으로 분배한다.
           단, 첫 카드는 좌측 끝에 정확히 붙고 마지막 카드는 우측 끝에 정확히 붙도록
           경계(처음/끝)에서는 해당 방향 패딩을 0으로 만든다. */
        function computePeek() {
          var card = slider.querySelector('.series-card');
          if (!card || window.innerWidth <= 900) return 0;
          var gap = parseFloat(getComputedStyle(slider).columnGap || 16);
          var cardWidth = card.getBoundingClientRect().width;
          var vpWidth = viewport.getBoundingClientRect().width;
          var targetCount = 3;
          var peek = (vpWidth - targetCount * cardWidth - (targetCount - 1) * gap) / 2;
          return peek < 16 ? 16 : peek;
        }
        function maxIndex(peek) {
          var step = cardStep();
          var maxScrollBase = Math.max(0, slider.scrollWidth - viewport.clientWidth);
          return Math.ceil((peek + maxScrollBase) / step);
        }
        function isMobile() { return window.innerWidth <= 900; }
        function updateMobileUI() {
          var maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
          var scrollLeft = viewport.scrollLeft;
          prevBtn.disabled = scrollLeft <= 2;
          nextBtn.disabled = scrollLeft >= maxScroll - 2;
          var fill = document.querySelector('#platform .series-progress-fill');
          if (fill) {
            var pct = maxScroll > 0 ? ((scrollLeft / maxScroll) * 80 + 20) : 100;
            fill.style.width = pct + '%';
          }
        }
        function update() {
          // 모바일: 네이티브 가로 스크롤(스와이프)로 카드가 움직이므로,
          // JS 트랜스폼 기반 위치 계산을 하지 않고 스크롤 위치 기준으로만 UI(진행바/버튼)를 갱신한다.
          if (isMobile()) {
            slider.style.transform = '';
            viewport.style.paddingLeft = '';
            viewport.style.paddingRight = '';
            updateMobileUI();
            return;
          }
          var peek = computePeek();
          var mi = maxIndex(peek);
          if (index > mi) index = mi;
          if (index < 0) index = 0;
          var padLeft = (index === 0) ? 0 : peek;
          viewport.style.paddingLeft = padLeft + 'px';
          viewport.style.paddingRight = peek + 'px';
          var maxScrollBase = Math.max(0, slider.scrollWidth - viewport.clientWidth);
          var offset = Math.min(index * cardStep(), padLeft + maxScrollBase);
          slider.style.transform = 'translateX(-' + offset + 'px)';
          prevBtn.disabled = index <= 0;
          nextBtn.disabled = index >= mi;
          var fill = document.querySelector('#platform .series-progress-fill');
          if (fill) { var pct = mi > 0 ? ((index / mi) * 80 + 20) : 100; fill.style.width = pct + '%'; }
        }
        prevBtn.addEventListener('click', function() {
          if (isMobile()) { viewport.scrollBy({ left: -cardStep(), behavior: 'smooth' }); return; }
          index -= 1; update();
        });
        nextBtn.addEventListener('click', function() {
          if (isMobile()) { viewport.scrollBy({ left: cardStep(), behavior: 'smooth' }); return; }
          index += 1; update();
        });
        window.addEventListener('resize', update);
        var mobileScrollRaf = null;
        viewport.addEventListener('scroll', function() {
          if (!isMobile()) return;
          if (mobileScrollRaf) return;
          mobileScrollRaf = requestAnimationFrame(function() { mobileScrollRaf = null; updateMobileUI(); });
        }, { passive: true });
        update();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSeriesSlider);
      } else {
        initSeriesSlider();
      }
    })();
  </script>
  <div class="container">
    <div class="section-header">
      <div class="section-header-row">
        <h2 style="color:#EDEEF0;">From Data<br>to Intelligence</h2>
        <p>현장 데이터를 연결하고 온톨로지를 통해<br>의미를 부여하여 AI 기반 의사결정으로 이어집니다.</p>
      </div>
    </div>
    <div class="platform-graphic-wrap">
      <img src="From%20Data%20to%20Intelligence.svg" alt="Refinery 플랫폼 아이소메트릭 다이어그램" class="platform-graphic-img" loading="lazy" decoding="async" style="display:block;width:100%;height:auto;">
    </div>
    <div class="series-nav-row">
      <div class="series-progress"><div class="series-progress-fill"></div></div>
      <div class="series-nav-btns">
        <button type="button" class="series-nav-btn series-prev" aria-label="이전 카드">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="series-nav-btn series-next" aria-label="다음 카드">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
    <div class="series-viewport">
      <div class="series-slider">
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="산업 데이터 통합"><i class="ph ph-share-network"></i></div>
        <h3>산업 데이터 통합</h3>
        <p class="series-desc">현장의 여러 설비와 시스템에 흩어진 데이터를<br>한곳에 모으는 첫 단계입니다.</p>
      </div>
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="온톨로지"><i class="ph ph-tree-structure"></i></div>
        <div class="series-tagline">Ontology</div>
