---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/global.css';
// 헤더·푸터는 한국어와 같은 공용 컴포넌트를 쓴다(라벨·IA는 src/i18n/nav.ts에서 로케일별로).
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// hreflang: 존재하는 로케일만(ko·en). ja 페이지 생성 후 추가.
const alternates = [
  { lang: 'ko', href: '/' },
  { lang: 'en', href: '/en' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Refinery",
  "url": "https://refinery.kr/",
  "logo": "https://refinery.kr/logo_Refinery_symbol.svg",
  "description": "Refine the complexity of industrial data into clear insight — from collection to AI analysis, prediction, and autonomous control. Build an organization that decides with data.",
  "sameAs": []
};
---
<BaseLayout
  title="Refinery — Refining complexity into pure insight"
  ogTitle="Refinery"
  description="Refine the complexity of industrial data into clear insight — from collection to AI analysis, prediction, and autonomous control. Build an organization that decides with data."
  ogDescription="Refining complexity into pure insight"
  canonical="/en"
  alternates={alternates}
  jsonLd={jsonLd}
>

<Nav />

<!-- HERO -->
<main id="main">
<section id="hero">
  <div class="container">
    <div class="hero-row">
      <div class="hero-text">
        <h1>Refinery <span class="hero-title-accent">Agentic AI</span></h1>
        <p>Connect the data and documents scattered across your operations <br class="mobile-br">into a single body of industrial knowledge.<br>AI understands the field and supports every operational decision — <br class="mobile-br">from predictive maintenance to quality, energy, and autonomous operation.</p>
      </div>
      <div class="hero-actions">
        <a href="/contact" class="hero-demo-link" onclick="if(window.openContactDrawer){openContactDrawer();return false;}">
          Request a demo
          <svg width="20" height="20" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
        </a>
      </div>
    </div>
    <div class="hero-motion-placeholder">
      <iframe id="hero-agent-iframe" data-src="/agent-replay-demo-en" loading="lazy" title="Refinery AI agent demo" scrolling="no" tabindex="-1" style="display:block;border:none;position:absolute;top:0;left:0;transform-origin:top left;pointer-events:none;"></iframe>
        </div>

  </div>
  
  <script is:inline>
    (function() {
      var HERO_AGENT_W = 1440;
      var HERO_AGENT_H = 900;
      var HERO_MOBILE_CROP_LEFT = 283;  /* 좌측 세션 레일(.rail) 끝 지점 = 283px (agent-replay-demo 기준). 레일을 잘라 대화 본문만 확대 */
      var HERO_MOBILE_CROP_RIGHT = 1427; /* 대화 본문(.main) 우측 끝 = 1427px. 본문 전체를 보여준다 */
      function resizeHeroAgent() {
        var wrapper = document.querySelector('.hero-motion-placeholder');
        if (!wrapper) return;
        var w = wrapper.offsetWidth;
        var h = wrapper.offsetHeight;
        var isMobile = window.innerWidth <= 900;
        // 데스크탑: 폭 기준으로만 스케일링해 좌우/우측이 잘리지 않고 전체 화면이 그대로 보이도록 한다.
        // 모바일: 화면이 좁아 전체를 다 보여주면 글씨가 너무 작아지므로,
        // 좌측 세션 레일과 우측 여백/툴바 아이콘을 잘라내고 대화 본문 위주로 확대해서 보여준다.
        var effectiveW = isMobile ? (HERO_MOBILE_CROP_RIGHT - HERO_MOBILE_CROP_LEFT) : HERO_AGENT_W;
        var scale = w / effectiveW;
        var leftOffset = isMobile ? -(HERO_MOBILE_CROP_LEFT * scale) : 0;
        var scaledH = HERO_AGENT_H * scale;
        var topOffset = Math.max(0, (h - scaledH) / 2);
        var iframe = document.getElementById('hero-agent-iframe');
        if (iframe) {
          iframe.style.width = HERO_AGENT_W + 'px';
          iframe.style.height = HERO_AGENT_H + 'px';
          iframe.style.transform = 'scale(' + scale + ')';
          iframe.style.top = topOffset + 'px';
          iframe.style.left = leftOffset + 'px';
        }
      }
      window.resizeHeroAgent = resizeHeroAgent;
      window.addEventListener('load', resizeHeroAgent);
      window.addEventListener('resize', resizeHeroAgent);
      document.addEventListener('DOMContentLoaded', resizeHeroAgent);

      function loadHeroDemo() {
        var f = document.getElementById('hero-agent-iframe');
        if (f && !f.src && f.getAttribute('data-src')) {
          f.addEventListener('load', resizeHeroAgent);
          f.src = f.getAttribute('data-src');
        }
      }
      if ('requestIdleCallback' in window) {
        window.addEventListener('load', function () { requestIdleCallback(loadHeroDemo, { timeout: 1500 }); });
      } else {
        window.addEventListener('load', function () { setTimeout(loadHeroDemo, 200); });
      }

      /* 히어로 데모가 재생 완료된 뒤 화면 밖으로 나갔다가 다시 들어오면
         재생을 처음부터 다시 시작한다 (멈춰있는 화면처럼 보이지 않도록). */
      function initHeroReplay() {
        var heroSection = document.getElementById('hero');
        var iframe = document.getElementById('hero-agent-iframe');
        if (!heroSection || !iframe || !('IntersectionObserver' in window)) return;
        var hasLeft = false;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              if (hasLeft) {
                hasLeft = false;
                try {
                  iframe.contentWindow.postMessage({ type: 'refinery-hero-replay' }, '*');
                } catch (e) { /* 접근 불가 시 무시 */ }
              }
            } else {
              hasLeft = true;
            }
          });
        }, { threshold: 0.5 });
        observer.observe(heroSection);
      }
      window.addEventListener('load', initHeroReplay);
    })();
  </script>
  </section>

<!-- PLATFORM -->
<section id="platform" style="background:#111316;border-top:1px solid #E3E7EC;">
  <style is:global>
    #platform .section-header p {
      color: #959CA5;
    }
    #platform .platform-graphic-img {
      margin-top: 64px;
    }
    #platform .series-nav-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 48px;
    }
    #platform .series-progress {
      width: 120px;
      height: 3px;
      border-radius: 2px;
      background: #272B32;
      overflow: hidden;
    }
    #platform .series-progress-fill {
      height: 100%;
      width: 20%;
      background: var(--accent);
      border-radius: 2px;
      transition: width .35s cubic-bezier(0.22,1,0.36,1);
    }
    #platform .series-nav-btns {
      display: flex;
      gap: 10px;
    }
    #platform .series-nav-btn {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid #272B32;
      background: #111316;
      color: #EDEEF0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
      padding: 0;
    }
    #platform .series-nav-btn:hover {
      background: var(--accent);
      border-color: var(--accent);
    }
    #platform .series-nav-btn:disabled {
      opacity: 0.35;
      cursor: default;
      background: #111316;
      border-color: #272B32;
    }
    /* 쉐브론 화살표는 기하학적으로는 중앙이지만, 뾰족한 끝과 벌어진 두 선의 무게중심이
       달라 눈으로 보면 한쪽으로 치우쳐 보인다 — 시각적으로 가운데처럼 보이도록 미세 보정 */
    #platform .series-prev svg {
      transform: translateX(-1px);
    }
    #platform .series-next svg {
      transform: translateX(1px);
    }
    #platform .series-viewport {
      overflow: hidden;
      margin: 16px 0 0;
      padding: 0 0 4px;
    }
    #platform .series-slider {
      display: flex;
      gap: 16px;
      transition: transform 0.45s cubic-bezier(0.22,1,0.36,1);
      will-change: transform;
    }
    #platform .series-card {
      flex: 0 0 300px;
      background: #111316;
      border: 1px solid #272B32;
      border-radius: var(--radius);
      padding: 24px;
    }
    #platform .series-icon {
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      margin-bottom: 80px;
    }
    #platform .series-icon svg {
      width: 26px;
      height: 26px;
    }
    #platform .series-icon i {
      font-size: 26px;
      line-height: 1;
    }
    #platform .series-card h3 {
      font-size: 16px;
      font-weight: 600;
      color: #EDEEF0;
      margin: 0 0 10px;
      line-height: 1.4;
    }
    #platform .series-tagline {
      font-size: 12px;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 1.2px;
      margin-bottom: 8px;
    }
    #platform .series-card:has(.series-tagline) .series-icon {
      margin-bottom: 52.8px;
    }
    #platform .series-en {
      color: #959CA5;
      font-weight: 400;
      font-size: 0.8em;
      display: block;
      margin-top: 2px;
    }
    #platform .series-quote {
      font-size: 13px;
      font-style: italic;
      color: var(--accent);
      margin: 0 0 10px;
      line-height: 1.55;
    }
    #platform .series-desc {
      font-size: 13px;
      color: #959CA5;
      line-height: 1.65;
      margin: 0;
    }
    @media (max-width: 900px) {
      #platform .platform-graphic-wrap {
        margin: 40px -24px 0;
        padding: 0 24px 6px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      #platform .platform-graphic-wrap::-webkit-scrollbar { display: none; }
      #platform .platform-graphic-img {
        margin-top: 0;
        width: auto;
        min-width: 680px;
        max-width: none;
      }
      #platform .series-viewport {
        margin: 16px 0 0;
        padding: 0 0 4px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      #platform .series-viewport::-webkit-scrollbar { display: none; }
      #platform .series-card {
        flex: 0 0 80vw;
        max-width: 300px;
        padding: 20px;
      }
      #platform .series-icon {
        margin-bottom: 56px;
      }
      #platform .series-card:has(.series-tagline) .series-icon {
        margin-bottom: 40px;
      }
    }
  </style>
  <script is:inline>
    (function() {
      function initSeriesSlider() {
        var viewport = document.querySelector('#platform .series-viewport');
        var slider = document.querySelector('#platform .series-slider');
        var prevBtn = document.querySelector('#platform .series-prev');
        var nextBtn = document.querySelector('#platform .series-next');
        if (!viewport || !slider || !prevBtn || !nextBtn) return;
        var index = 0;
        function cardStep() {
          var card = slider.querySelector('.series-card');
          if (!card) return 316;
          var gap = parseFloat(getComputedStyle(slider).columnGap || 16);
          return card.getBoundingClientRect().width + gap;
        }
        /* 좌우 잘리는 카드(peek)가 동일한 크기로 보이도록, 가운데 3장이 꽉 차고
           남는 여백만큼을 뷰포트 좌우 패딩(peek)으로 분배한다.
           단, 첫 카드는 좌측 끝에 정확히 붙고 마지막 카드는 우측 끝에 정확히 붙도록
           경계(처음/끝)에서는 해당 방향 패딩을 0으로 만든다. */
        function computePeek() {
          var card = slider.querySelector('.series-card');
          if (!card || window.innerWidth <= 900) return 0;
          var gap = parseFloat(getComputedStyle(slider).columnGap || 16);
          var cardWidth = card.getBoundingClientRect().width;
          var vpWidth = viewport.getBoundingClientRect().width;
          var targetCount = 3;
          var peek = (vpWidth - targetCount * cardWidth - (targetCount - 1) * gap) / 2;
          return peek < 16 ? 16 : peek;
        }
        function maxIndex(peek) {
          var step = cardStep();
          var maxScrollBase = Math.max(0, slider.scrollWidth - viewport.clientWidth);
          return Math.ceil((peek + maxScrollBase) / step);
        }
        function isMobile() { return window.innerWidth <= 900; }
        function updateMobileUI() {
          var maxScroll = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
          var scrollLeft = viewport.scrollLeft;
          prevBtn.disabled = scrollLeft <= 2;
          nextBtn.disabled = scrollLeft >= maxScroll - 2;
          var fill = document.querySelector('#platform .series-progress-fill');
          if (fill) {
            var pct = maxScroll > 0 ? ((scrollLeft / maxScroll) * 80 + 20) : 100;
            fill.style.width = pct + '%';
          }
        }
        function update() {
          // 모바일: 네이티브 가로 스크롤(스와이프)로 카드가 움직이므로,
          // JS 트랜스폼 기반 위치 계산을 하지 않고 스크롤 위치 기준으로만 UI(진행바/버튼)를 갱신한다.
          if (isMobile()) {
            slider.style.transform = '';
            viewport.style.paddingLeft = '';
            viewport.style.paddingRight = '';
            updateMobileUI();
            return;
          }
          var peek = computePeek();
          var mi = maxIndex(peek);
          if (index > mi) index = mi;
          if (index < 0) index = 0;
          var padLeft = (index === 0) ? 0 : peek;
          viewport.style.paddingLeft = padLeft + 'px';
          viewport.style.paddingRight = peek + 'px';
          var maxScrollBase = Math.max(0, slider.scrollWidth - viewport.clientWidth);
          var offset = Math.min(index * cardStep(), padLeft + maxScrollBase);
          slider.style.transform = 'translateX(-' + offset + 'px)';
          prevBtn.disabled = index <= 0;
          nextBtn.disabled = index >= mi;
          var fill = document.querySelector('#platform .series-progress-fill');
          if (fill) { var pct = mi > 0 ? ((index / mi) * 80 + 20) : 100; fill.style.width = pct + '%'; }
        }
        prevBtn.addEventListener('click', function() {
          if (isMobile()) { viewport.scrollBy({ left: -cardStep(), behavior: 'smooth' }); return; }
          index -= 1; update();
        });
        nextBtn.addEventListener('click', function() {
          if (isMobile()) { viewport.scrollBy({ left: cardStep(), behavior: 'smooth' }); return; }
          index += 1; update();
        });
        window.addEventListener('resize', update);
        var mobileScrollRaf = null;
        viewport.addEventListener('scroll', function() {
          if (!isMobile()) return;
          if (mobileScrollRaf) return;
          mobileScrollRaf = requestAnimationFrame(function() { mobileScrollRaf = null; updateMobileUI(); });
        }, { passive: true });
        update();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSeriesSlider);
      } else {
        initSeriesSlider();
      }
    })();
  </script>
  <div class="container">
    <div class="section-header">
      <div class="section-header-row">
        <h2 style="color:#EDEEF0;">From Data<br>to Intelligence</h2>
        <p>Connect field data and, through an ontology,<br>give it meaning that leads to AI-driven decisions.</p>
      </div>
    </div>
    <div class="platform-graphic-wrap">
      <img src="From%20Data%20to%20Intelligence.svg" alt="Refinery platform isometric diagram" class="platform-graphic-img" loading="lazy" decoding="async" style="display:block;width:100%;height:auto;">
    </div>
    <div class="series-nav-row">
      <div class="series-progress"><div class="series-progress-fill"></div></div>
      <div class="series-nav-btns">
        <button type="button" class="series-nav-btn series-prev" aria-label="Previous">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="series-nav-btn series-next" aria-label="Next">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
    <div class="series-viewport">
      <div class="series-slider">
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="Industrial data integration"><i class="ph ph-share-network"></i></div>
        <h3>Industrial data integration</h3>
        <p class="series-desc">Data scattered across field equipment and systems<br>is unified in one place — the first step.</p>
      </div>
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="Ontology"><i class="ph ph-tree-structure"></i></div>
        <div class="series-tagline">Ontology</div>
        <h3>A structure that gives data meaning</h3>
        <p class="series-desc">It attaches meaning to every scattered number and record — "what each piece of<br>data is about." </p>
      </div>
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="Workflow"><i class="ph ph-git-branch"></i></div>
        <div class="series-tagline">Workflow</div>
        <h3>Operational procedures designed through dialogue</h3>
        <p class="series-desc">You define which cases need approval and which run automatically —<br>all through conversation.</p>
      </div>
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="Plate"><i class="ph ph-presentation"></i></div>
        <div class="series-tagline">Plate</div>
        <h3>The whole field on a single dashboard</h3>
        <p class="series-desc">Check real-time KPIs, status, and alarms<br>all on one screen.</p>
      </div>
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="Lens"><i class="ph ph-magnifying-glass"></i></div>
        <div class="series-tagline">Lens</div>
        <h3>Analysis that finds causes and forecasts the future</h3>
        <p class="series-desc">It reviews data accumulated over time<br>to spot anomalies and pinpoint their causes.</p>
      </div>
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="AI Agent"><i class="ph ph-sparkle"></i></div>
        <div class="series-tagline">AI Agent</div>
        <h3>A field that moves with a single question</h3>
        <p class="series-desc">Ask a question and it answers from the data,<br>and even suggests the next action.</p>
      </div>
      <div class="series-card">
        <div class="series-icon" role="img" aria-label="Automation"><i class="ph ph-robot"></i></div>
        <h3>Automation — operations that run without hands-on work</h3>
        <p class="series-desc">Analysis flows into reports, alarms, and workflow execution<br>automatically, without manual steps.</p>
      </div>
      </div>
    </div>
  </div>
</section>

<!-- INDUSTRIES -->
<section id="industries" style="background:#F6F8FA;border-top:1px solid #E3E7EC;">
  <div class="container">
    <div class="section-header">
      <div class="section-header-row">
        <h2>Optimized for every field,<br>a platform for any industry</h2>
        <p>The Refinery AI Agent learns and solves<br>the unique challenges of each industry.</p>
      </div>
    </div>
    <div class="industries-grid">
      <div class="industry-card"><div class="industry-name">Energy · Utilities</div><div class="industry-desc">Unified control of distributed assets,<br>automated ESG compliance</div><img loading="lazy" decoding="async" src="industry-08.svg" alt="Energy · Utilities" style="position:absolute;right:-10px;bottom:-10px;width:100px;height:100px;opacity:0.15;transition:transform 0.3s ease, opacity 0.3s ease;transform-origin:bottom right;"></div>
      <div class="industry-card"><div class="industry-name">Oil · Gas</div><div class="industry-desc">Predictive maintenance for large-scale assets,<br>AI-optimized energy efficiency</div><img loading="lazy" decoding="async" src="industry-04.svg" alt="Oil · Gas" style="position:absolute;right:-10px;bottom:-10px;width:100px;height:100px;opacity:0.15;transition:transform 0.3s ease, opacity 0.3s ease;transform-origin:bottom right;"></div>
      <div class="industry-card"><div class="industry-name">Data Center</div><div class="industry-desc">Power & cooling efficiency,<br>real-time power-quality monitoring</div><img loading="lazy" decoding="async" src="industry-01.svg" alt="Data Center" style="position:absolute;right:-10px;bottom:-10px;width:100px;height:100px;opacity:0.15;transition:transform 0.3s ease, opacity 0.3s ease;transform-origin:bottom right;"></div>
      <div class="industry-card"><div class="industry-name">Steel</div><div class="industry-desc">Real-time monitoring of high-temperature processes,<br>AI quality prediction</div><img loading="lazy" decoding="async" src="industry-05.svg" alt="Steel" style="position:absolute;right:-10px;bottom:-10px;width:100px;height:100px;opacity:0.15;transition:transform 0.3s ease, opacity 0.3s ease;transform-origin:bottom right;"></div>
      <div class="industry-card"><div class="industry-name">Chemicals · Fine Chemicals</div><div class="industry-desc">Reaction-process optimization,<br>AI safety monitoring</div><img loading="lazy" decoding="async" src="industry-03.svg" alt="Chemicals · Fine Chemicals" style="position:absolute;right:-10px;bottom:-10px;width:100px;height:100px;opacity:0.15;transition:transform 0.3s ease, opacity 0.3s ease;transform-origin:bottom right;"></div>
      <div class="industry-card"><div class="industry-name">Logistics</div><div class="industry-desc">Real-time detection of cold-chain temperature excursions,<br>AI anomaly alerts</div><img loading="lazy" decoding="async" src="industry-09.svg" alt="Logistics" style="position:absolute;right:-10px;bottom:-10px;width:100px;height:100px;opacity:0.15;transition:transform 0.3s ease, opacity 0.3s ease;transform-origin:bottom right;"></div>
      <div class="industry-card"><div class="industry-name">Environment</div><div class="industry-desc">Automated data-quality diagnostics for monitoring stations,<br>automated ESG report generation</div><img loading="lazy" decoding="async" src="industry-07.svg" alt="Environment" style="position:absolute;right:-10px;bottom:-10px;width:100px;height:100px;opacity:0.15;transition:transform 0.3s ease, opacity 0.3s ease;transform-origin:bottom right;"></div>
          </div>
  </div>
</section>

