  .cd-back{flex:none;padding:14px 20px;background:transparent;border:1px solid var(--border,#E3E7EC);border-radius:8px;color:#555;font-size:15px;font-weight:600;cursor:pointer;transition:background .2s;}
  .cd-back:hover{background:#f4f4f5;}
  .cd-success{display:none;text-align:center;padding:80px 0;}
