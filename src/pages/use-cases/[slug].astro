---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SignalIcon from '../../components/SignalIcon.astro';
import '../../styles/industry.css';
import { useCases, findUseCase } from '../../data/usecases';

export function getStaticPaths() {
  return useCases.map((u) => ({ params: { slug: u.slug }, props: { slug: u.slug } }));
}

const { slug } = Astro.props;
const uc = findUseCase(slug)!;
const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: uc.seo.title,
  url: `${SITE}/use-cases/${uc.slug}`,
  isPartOf: { '@type': 'WebSite', name: 'Refinery', url: `${SITE}/` },
};
---
<BaseLayout title={uc.seo.title} description={uc.seo.description} canonical={`/use-cases/${uc.slug}`} jsonLd={jsonLd}>
  <Nav />
  {/* slug 클래스로 페이지별 스타일 스코프를 연다. 공통 .ind-* 규칙은 건드리지 않으므로
      이 클래스를 쓰지 않는 다른 유즈케이스는 기존 디자인 그대로다. */}
  <main class={`ind uc-page uc-${uc.slug}`}>
    <!-- HERO -->
    <section class={uc.heroImageAsBackground && uc.heroImage ? 'ind-hero uc-hero-bg' : 'ind-hero'}>
      {uc.heroImageAsBackground && uc.heroImage && (
        <img
          class="uc-hero-bg-img"
          src={uc.heroImage.src}
          alt=""
          aria-hidden="true"
          width={uc.heroImage.width}
          height={uc.heroImage.height}
          decoding="async"
          fetchpriority="high"
        />
      )}
      <div class={uc.heroAlignsWithNav ? 'ind-container uc-container--nav' : 'ind-container'}>
        <div class={uc.heroImage && !uc.heroImageAsBackground ? 'uc-hero-row' : undefined}>
          <div class="uc-hero-text">
            {(uc.showBreadcrumb ?? true) && (
              <nav class="ind-crumb" aria-label="위치"><a href="/">Home</a><span>›</span><a href="/use-cases">유즈케이스</a><span>›</span><span>{uc.name}</span></nav>
            )}
            {uc.heroTaglineAsTitle ? (
              <Fragment>
                {/* 위계를 뒤집은 형태 — 과제명이 태그라인, tagline 문장이 대제목이다.
                    설명 문단은 그 문장과 겹치므로 렌더하지 않는다. */}
                <p class="uc-hero-tag">{uc.name}</p>
                <h1 set:html={uc.heroTitle ?? uc.tagline}></h1>
              </Fragment>
            ) : (
              <Fragment>
                {(uc.showEyebrow ?? true) && <p class="ind-eyebrow">{uc.eyebrow ?? 'USE CASE'}</p>}
                <h1>{uc.name}</h1>
                <p class="ind-lede">{uc.tagline}</p>
              </Fragment>
            )}
            <div class="ind-hero-actions">
              <a href="/contact" class="ind-btn-primary">문의하기</a>
              <a href={uc.heroSecondaryAction?.href ?? '/why-refinery'} class="ind-btn-ghost">{uc.heroSecondaryAction?.label ?? '플랫폼 개요 →'}</a>
            </div>
          </div>
          {uc.heroImage && !uc.heroImageAsBackground && (
            <figure class="uc-hero-figure">
              {/* 히어로 최상단 이미지 → LCP 대상이므로 lazy 금지 */}
              <img
                src={uc.heroImage.src}
                alt={uc.heroImage.alt}
                width={uc.heroImage.width}
                height={uc.heroImage.height}
                decoding="async"
                fetchpriority="high"
              />
              {uc.heroImage.caption && <figcaption>{uc.heroImage.caption}</figcaption>}
            </figure>
          )}
        </div>
      </div>
    </section>

    <!-- 문제 -->
    <section class="ind-section">
      <div class="ind-container uc-narrow">
        <header class="ind-head"><span class="ind-badge">왜 필요한가</span></header>
        <p class="uc-problem">{uc.problem}</p>
      </div>
    </section>

    <!-- 어떻게 -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head"><h2>Refinery는 이렇게 풉니다</h2></header>
        <div class="ind-grid ind-grid-3">
          {uc.how.map((h) => (
            <div class="ind-card">
              {h.icon && <span class="uc-card-icon" aria-hidden="true"><i class={`ph ${h.icon}`}></i></span>}
              <h3>{h.title}</h3>
              <p set:html={h.desc}></p>
            </div>
          ))}
        </div>

        {uc.template && (
          <div class={uc.template.image ? 'uc-template uc-template--split' : 'uc-template'}>
            <div class="uc-template-body">
              <span class="uc-template-badge"><i class="ph ph-blueprint" aria-hidden="true"></i> {uc.template.badge ?? '템플릿으로 시작'}</span>
              <h3>{uc.template.title}</h3>
              <p>{uc.template.desc}</p>
              {uc.template.includes && (
                <ul class="uc-template-list">
                  {uc.template.includes.map((it) => <li><i class="ph ph-check" aria-hidden="true"></i>{it}</li>)}
                </ul>
              )}
            </div>
            {uc.template.image && (
              <figure class="uc-template-figure">
                <img
                  src={uc.template.image.src}
                  alt={uc.template.image.alt}
                  width={uc.template.image.width}
                  height={uc.template.image.height}
                  loading="lazy"
                  decoding="async"
                />
                {uc.template.image.caption && <figcaption>{uc.template.image.caption}</figcaption>}
              </figure>
            )}
          </div>
        )}
      </div>
    </section>


    <!-- 다루는 신호 -->
    <section class="ind-section">
      <div class="ind-container uc-narrow">
        <header class={uc.relatedAsHeaderLink && uc.related ? 'ind-head uc-head-row' : 'ind-head'}>
          <h2>다루는 데이터와 신호</h2>
          {uc.relatedAsHeaderLink && uc.related && (
            <a class="uc-more-link" href={uc.related.href}>
              {uc.related.label}
              <svg width="20" height="20" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
            </a>
          )}
        </header>
        {uc.signalsAsCards ? (
          <div class="uc-signal-cards">
            {uc.signals.map((s) => {
              const label = typeof s === 'string' ? s : s.label;
              const icon = typeof s === 'string' ? undefined : s.icon;
              return (
                <div class="uc-signal">
                  <span class="uc-signal-icon" aria-hidden="true">
                    {icon && (icon.startsWith('ph-')
                      ? <i class={`ph ${icon}`}></i>
                      : <SignalIcon name={icon} />)}
                  </span>
                  <span class="uc-signal-label">{label}</span>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="uc-chips">
            {uc.signals.map((s) => <span class="uc-chip">{typeof s === 'string' ? s : s.label}</span>)}
          </div>
        )}
        {uc.related && !uc.relatedAsHeaderLink && (
          <p class="uc-related">더 읽어보기: <a href={uc.related.href}>{uc.related.label}</a></p>
        )}
      </div>
    </section>

    {/* 다른 과제 — 데이터에서 showRelatedUseCases를 켠 유즈케이스에만 렌더된다.
        아래 CTA가 어두운 배경이라 이 구역은 흰 배경으로 두어 대비로 구분한다. */}
    {uc.showRelatedUseCases && (
      <section class="ind-section">
        <div class="ind-container uc-narrow">
          <header class="ind-head"><h2>다른 과제 더 살펴보기</h2></header>
          <div class="uc-cases">
            {useCases.filter((u) => u.slug !== uc.slug).map((u) => (
              <a class={u.cardImage ? 'uc-case uc-case--img' : 'uc-case'} href={`/use-cases/${u.slug}`}>
                {u.cardImage && (
                  <img
                    class="uc-case-img"
                    src={u.cardImage.src}
                    alt=""
                    aria-hidden="true"
                    width={u.cardImage.width}
                    height={u.cardImage.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="uc-case-body">
                  <span class="uc-case-label">{u.name}</span>
                  <p class="uc-case-desc" set:html={u.cardDesc ?? u.tagline}></p>
                  <span class="uc-case-go" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class={uc.ctaBackgroundImage ? 'ind-cta uc-cta-bg' : 'ind-cta'}>
      {uc.ctaBackgroundImage && (
        <img
          class="uc-cta-bg-img"
          src={uc.ctaBackgroundImage}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="ind-container">
        <h2 set:html={uc.ctaTitle ?? '우리 현장에 어떻게 적용될지<br>함께 살펴봐요.'}></h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .uc-narrow { max-width: 760px; }
  .uc-problem { font-size: 18px; line-height: 1.8; color: #2b3644; }
  .uc-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .uc-chip {
    font-size: 14px; color: #16202c; background: #fff; border: 1px solid var(--border);
    border-radius: 999px; padding: 8px 16px;
  }
  /* 다른 과제 — 6개를 3열 2행 카드로 둔다. 규격은 위 '이렇게 풉니다' 카드와 같다
     (흰 배경 · 1px 테두리 · radius 12 · padding 24). 링크라 hover를 준다. */
  .uc-cases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  /* 배경 이미지를 꽉 채울 예정이라 세로를 키우고 제목을 아래쪽에 둔다.
     이미지가 들어와도 제목 위치가 그대로라 레이아웃이 흔들리지 않는다.
     position/overflow는 나중에 넣을 이미지가 라운드 모서리 안에 잘리도록 미리 잡아둔 것. */
  .uc-case {
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end;
    min-height: 320px;
    color: #16202c;
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 24px;
    transition: border-color .2s, color .2s, box-shadow .2s;
  }
  /* keep-all — 없으면 한국어가 어절 중간에서 잘린다('흩어/진', '데/이터').
     띄어쓰기에서만 줄을 바꿔 읽는 단위가 유지된다. */
  .uc-case-body { position: relative; z-index: 1; word-break: keep-all; }
  /* 제목·설명 크기는 랜딩 산업 카드(.industry-name / .industry-desc)와 같은 값. */
  .uc-case-label { display: block; font-size: 20px; font-weight: 600; margin-bottom: 5px; }
  .uc-case-desc { font-size: 15px; line-height: 1.5; color: var(--text-muted); text-wrap: pretty; }
  /* 글자 없이 화살표 아이콘만. 카드 전체가 링크라 이름은 제목이 맡고,
     이 아이콘은 '넘어간다'는 신호만 준다(그래서 aria-hidden). */
  .uc-case-go {
    display: inline-flex; margin-top: 14px; color: #4b86bf;
    transition: transform .2s ease;
  }
  .uc-case-go svg { display: block; }
  .uc-case:hover .uc-case-go { transform: translateX(4px); }
  @media (max-width: 860px) {
    .uc-cases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .uc-cases { grid-template-columns: 1fr; }
  }
  .uc-case:hover { border-color: var(--accent); color: #4b86bf; box-shadow: 0 4px 14px rgba(16,32,44,.06); }

  /* 배경 이미지가 있는 카드(데이터에 cardImage를 넣은 것만).
     이미지 → 스크림 → 제목 순으로 쌓아 사진 위에서도 글자가 읽히게 한다.
     테두리를 없애야 이미지가 카드를 끝까지 채운다. 테두리를 두면
     inset:0이 패딩 박스 기준이라 사방 1px씩 흰 테가 남는다. */
  .uc-case-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; pointer-events: none; user-select: none;
    transition: transform .3s ease;
  }
  /* 하단 그라데이션 — 글 묶음이 카드의 52~93% 구간에 놓이므로,
     위쪽 절반은 사진을 거의 그대로 두고 그 구간부터 빠르게 짙어지게 한다.
     (전체에 고르게 깔면 글자 자리가 중간 톤이 되어 사진도 흐려지고 글도 덜 읽힌다) */
  .uc-case--img::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg,
      rgba(11,14,20,0) 0%,
      rgba(11,14,20,.05) 30%,
      rgba(11,14,20,.66) 52%,
      rgba(11,14,20,.95) 100%);
  }
  .uc-case--img { border: none; }
  .uc-case--img .uc-case-label { color: #fff; }
  .uc-case--img .uc-case-desc { color: rgba(255,255,255,.82); }
  .uc-case--img .uc-case-go { color: #fff; }
  /* 사진 위에서는 글자색을 바꾸지 않고 이미지를 살짝 확대해 반응을 준다. */
  .uc-case--img:hover .uc-case-label { color: #fff; }
  .uc-case--img:hover .uc-case-img { transform: scale(1.04); }

  .uc-related { margin-top: 26px; font-size: 15px; color: #47535f; }
  .uc-related a { color: #4b86bf; text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }

  /* 템플릿 강조 밴드 */
  .uc-template {
    margin-top: 24px; background: #eef5fc; border: 1px solid #cfe0f0; border-radius: 14px;
    padding: 24px 26px;
  }
  .uc-template-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 700; letter-spacing: .02em; color: #2f6ba3;
    background: #fff; border: 1px solid #cfe0f0; border-radius: 999px; padding: 5px 12px;
  }
  /* 제목·설명 크기는 랜딩 산업 카드(.industry-name / .industry-desc)와 같은 값 —
     위 '이렇게 풉니다' 카드, 아래 '다른 과제' 카드와 한 규격으로 맞춘다.
     목록도 설명과 같은 15px으로 올려 밴드 안에서 글자 크기가 두 종류만 남게 한다. */
  .uc-template h3 { margin-top: 14px; font-size: 20px; font-weight: 600; line-height: 1.6; color: #16202c; }
  .uc-template p { margin-top: 5px; font-size: 15px; line-height: 1.5; color: var(--text-muted); }
  .uc-template-list { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 20px; }
  .uc-template-list li { display: flex; align-items: center; gap: 8px; font-size: 15px; color: #16202c; }
  .uc-template-list li i { color: #2f6ba3; font-size: 15px; flex: none; }
  @media (max-width: 560px) { .uc-template-list { grid-template-columns: 1fr; } }

  /* ───────────────────────────────────────────────────────────
     아래는 데이터에 해당 필드(heroImage·icon·template.image)를 넣은
     유즈케이스에서만 렌더되는 요소들이다. 넣지 않은 페이지에는 마크업 자체가
     생기지 않으므로 기존 6개 유즈케이스 디자인에는 영향이 없다.
     ─────────────────────────────────────────────────────────── */

  /* 히어로 배경 모드 — 랜딩 #cta와 같은 패턴(절대배치 img + object-fit: cover).
     사진 위에서 글이 읽히도록 어두운 스크림을 덮고 텍스트를 흰색 계열로 바꾼다. */
  .uc-hero-bg { position: relative; overflow: hidden; }
  .uc-hero-bg-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover;
    /* 세로 초점. 값을 낮출수록 사진의 위쪽이 보여 이미지가 아래로 내려간 것처럼 된다
       (0% = 위쪽 끝, 50% = 가운데, 100% = 아래쪽 끝). 섹션 크기·위치는 그대로다. */
    object-position: center 45%;
    pointer-events: none; user-select: none;
  }
  /* 스크림 — 좌측(글이 놓이는 쪽)을 더 진하게 해 대비를 확보한다 */
  .uc-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(11,14,20,.74) 0%, rgba(11,14,20,.46) 55%, rgba(11,14,20,.26) 100%);
  }
  .uc-hero-bg > .ind-container { position: relative; z-index: 1; }
  .uc-hero-bg h1 { color: #fff; }
  .uc-hero-bg .ind-lede { color: rgba(255,255,255,.82); }
  .uc-hero-bg .ind-crumb, .uc-hero-bg .ind-crumb a { color: rgba(255,255,255,.7); }
  .uc-hero-bg .ind-eyebrow { color: #9cc4e8; }
  /* 어두운 배경용 버튼 — global.css의 #cta .btn-primary와 같은 처리.
     페이지 전용 버튼 규칙(.uc-predictive-maintenance …, 선택자 3개)이 뒤에 선언돼 있어
     같은 우선순위면 그쪽이 이긴다. .uc-page를 붙여 4개로 올린다. */
  .uc-page .uc-hero-bg .ind-hero-actions .ind-btn-ghost {
    color: #fff; border-color: rgba(255,255,255,.6); background: transparent;
  }
  /* 제목이 문장이 되면서 히어로가 빽빽해져 위·사이 여백을 넓힌다
     (공통값은 margin-top 32px · gap 10px). */
  .uc-predictive-maintenance .ind-hero-actions { margin-top: 48px; gap: 16px; }

  /* 주 버튼(문의하기)은 accent 면으로 채워 사진 위에서 먼저 눈에 들어오게 한다. */
  .uc-page .uc-hero-bg .ind-hero-actions .ind-btn-primary {
    background: #76a6d7; color: #fff; border-color: #76a6d7;
  }
  /* 기본이 이미 accent 면이라 hover는 한 단계 어둡게 간다
     (흰 면으로 뒤집으면 보조 버튼 hover와 겹쳐 구분이 사라진다). */
  .uc-page .uc-hero-bg .ind-hero-actions .ind-btn-primary:hover {
    background: #5a8fc5; border-color: #5a8fc5; color: #fff;
  }
  /* 보조 버튼은 흰 면으로 뒤집는다 — 주 버튼(accent 면)과 상태가 겹치지 않는다. */
  .uc-page .uc-hero-bg .ind-hero-actions .ind-btn-ghost:hover {
    background: #fff; border-color: #fff; color: #76a6d7;
  }

  /* 히어로 2컬럼 (heroImage 있을 때만) */
  .uc-hero-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .uc-hero-figure { margin: 0; }
  .uc-hero-figure img {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--border); border-radius: 14px;
    background: #fff; box-shadow: 0 18px 46px rgba(16, 32, 44, 0.10);
  }
  .uc-hero-figure figcaption,
  .uc-template-figure figcaption { margin-top: 10px; font-size: 13px; color: var(--text-muted); }
  @media (max-width: 900px) {
    .uc-hero-row { grid-template-columns: 1fr; gap: 34px; }
  }

  /* 헤더(.nav-inner)와 같은 박스 — 좌측이 로고 선에 정확히 맞는다.
