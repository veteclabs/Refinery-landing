---
// 본문은 UseCasePage 컴포넌트가 렌더한다(영어 /en/use-cases/[slug]와 공유).
import UseCasePage from '../../components/UseCasePage.astro';
import { useCases, findUseCase } from '../../data/usecases';

export function getStaticPaths() {
  return useCases.map((u) => ({ params: { slug: u.slug }, props: { slug: u.slug } }));
}

const { slug } = Astro.props;
const uc = findUseCase(slug)!;
---
<UseCasePage uc={uc} lang="ko" />
