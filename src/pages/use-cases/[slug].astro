---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import SignalIcon from '../../components/SignalIcon.astro';
import '../../styles/industry.css';
import { useCases, findUseCase } from '../../data/usecases';

export function getStaticPaths() {
  return useCases.map((u) => ({ params: { slug: u.slug }, props: { slug: u.slug } }));
}

const { slug } = Astro.props;
const uc = findUseCase(slug)!;
const SITE = 'https://refinery.kr';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: uc.seo.title,
  url: `${SITE}/use-cases/${uc.slug}`,
  isPartOf: { '@type': 'WebSite', name: 'Refinery', url: `${SITE}/` },
};
---
<BaseLayout title={uc.seo.title} description={uc.seo.description} canonical={`/use-cases/${uc.slug}`} jsonLd={jsonLd}>
  <Nav />
  {/* slug 클래스로 페이지별 스타일 스코프를 연다. 공통 .ind-* 규칙은 건드리지 않으므로
      이 클래스를 쓰지 않는 다른 유즈케이스는 기존 디자인 그대로다. */}
  <main class={`ind uc-page uc-${uc.slug}`}>
    <!-- HERO -->
    <section class={uc.heroImageAsBackground && uc.heroImage ? 'ind-hero uc-hero-bg' : 'ind-hero'}>
      {uc.heroImageAsBackground && uc.heroImage && (
        <img
          class="uc-hero-bg-img"
          src={uc.heroImage.src}
          alt=""
          aria-hidden="true"
          width={uc.heroImage.width}
          height={uc.heroImage.height}
          decoding="async"
          fetchpriority="high"
        />
      )}
      <div class={uc.heroAlignsWithNav ? 'ind-container uc-container--nav' : 'ind-container'}>
        <div class={uc.heroImage && !uc.heroImageAsBackground ? 'uc-hero-row' : undefined}>
          <div class="uc-hero-text">
            {(uc.showBreadcrumb ?? true) && (
              <nav class="ind-crumb" aria-label="위치"><a href="/">Home</a><span>›</span><a href="/use-cases">유즈케이스</a><span>›</span><span>{uc.name}</span></nav>
            )}
            {uc.heroTaglineAsTitle ? (
              <Fragment>
                {/* 위계를 뒤집은 형태 — 과제명이 태그라인, tagline 문장이 대제목이다.
                    설명 문단은 그 문장과 겹치므로 렌더하지 않는다. */}
                <p class="uc-tag">{uc.name}</p>
                <h1 set:html={uc.heroTitle ?? uc.tagline}></h1>
              </Fragment>
            ) : (
              <Fragment>
                {(uc.showEyebrow ?? true) && <p class="ind-eyebrow">{uc.eyebrow ?? 'USE CASE'}</p>}
                <h1>{uc.name}</h1>
                <p class="ind-lede">{uc.tagline}</p>
              </Fragment>
            )}
            <div class="ind-hero-actions">
              <a href="/contact" class="ind-btn-primary">문의하기</a>
              <a href={uc.heroSecondaryAction?.href ?? '/why-refinery'} class="ind-btn-ghost">{uc.heroSecondaryAction?.label ?? '플랫폼 개요 →'}</a>
            </div>
          </div>
          {uc.heroImage && !uc.heroImageAsBackground && (
            <figure class="uc-hero-figure">
              {/* 히어로 최상단 이미지 → LCP 대상이므로 lazy 금지 */}
              <img
                src={uc.heroImage.src}
                alt={uc.heroImage.alt}
                width={uc.heroImage.width}
                height={uc.heroImage.height}
                decoding="async"
                fetchpriority="high"
              />
              {uc.heroImage.caption && <figcaption>{uc.heroImage.caption}</figcaption>}
            </figure>
          )}
        </div>
      </div>
    </section>

    <!-- 문제 -->
    <section class="ind-section uc-problem-section">
      <div class="ind-container uc-narrow">
        <header class="ind-head"><p class="uc-tag">왜 필요한가요?</p></header>
        <p class="uc-problem" set:html={uc.problemHtml ?? uc.problem}></p>
      </div>
    </section>

    <!-- 다루는 신호 -->
    <section class="ind-section">
      <div class="ind-container uc-narrow">
        <header class={uc.relatedAsHeaderLink && uc.related ? 'ind-head uc-head-row' : 'ind-head'}>
          <h2>읽는 데이터와 신호</h2>
          {uc.relatedAsHeaderLink && uc.related && (
            <a class="uc-more-link" href={uc.related.href}>
              {uc.related.label}
              <svg width="20" height="20" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
            </a>
          )}
        </header>
        {uc.signalsAsCards ? (
          <div class="uc-signal-cards">
            {uc.signals.map((s) => {
              const label = typeof s === 'string' ? s : s.label;
              const icon = typeof s === 'string' ? undefined : s.icon;
              return (
                <div class="uc-signal">
                  <span class="uc-signal-icon" aria-hidden="true">
                    {icon && (icon.startsWith('ph-')
                      ? <i class={`ph ${icon}`}></i>
                      : <SignalIcon name={icon} />)}
                  </span>
                  <span class="uc-signal-label">{label}</span>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="uc-chips">
            {uc.signals.map((s) => <span class="uc-chip">{typeof s === 'string' ? s : s.label}</span>)}
          </div>
        )}
        {uc.related && !uc.relatedAsHeaderLink && (
          <p class="uc-related">더 읽어보기: <a href={uc.related.href}>{uc.related.label}</a></p>
        )}
      </div>
    </section>

    <!-- 어떻게 -->
    <section class="ind-section ind-soft">
      <div class="ind-container">
        <header class="ind-head"><h2>Refinery로 푸는 방식</h2></header>
        <div class="ind-grid ind-grid-3">
          {uc.how.map((h) => (
            <div class="ind-card">
              {h.icon && <span class="uc-card-icon" aria-hidden="true"><i class={`ph ${h.icon}`}></i></span>}
              <h3>{h.title}</h3>
              <p set:html={h.desc}></p>
            </div>
          ))}
        </div>

        {uc.template && (
          <div class={uc.template.image ? 'uc-template uc-template--split' : 'uc-template'}>
            {uc.template.decoImage && (
              <img class="uc-template-deco" src={uc.template.decoImage} alt="" aria-hidden="true" loading="lazy" decoding="async" />
            )}
            <div class="uc-template-body">
              <span class="uc-template-badge"><i class="ph ph-blueprint" aria-hidden="true"></i> {uc.template.badge ?? '템플릿으로 시작'}</span>
              <h3>{uc.template.title}</h3>
              <p set:html={uc.template.desc}></p>
              {uc.template.includes && (
                <ul class="uc-template-list">
                  {uc.template.includes.map((it) => <li><i class="ph ph-check-circle" aria-hidden="true"></i>{it}</li>)}
                </ul>
              )}
            </div>
            {uc.template.image && (
              <figure class="uc-template-figure">
                <img
                  src={uc.template.image.src}
                  alt={uc.template.image.alt}
                  width={uc.template.image.width}
                  height={uc.template.image.height}
                  loading="lazy"
                  decoding="async"
                />
                {uc.template.image.caption && <figcaption>{uc.template.image.caption}</figcaption>}
              </figure>
            )}
          </div>
        )}
      </div>
    </section>


    {/* 다른 과제 — 데이터에서 showRelatedUseCases를 켠 유즈케이스에만 렌더된다.
        아래 CTA가 어두운 배경이라 이 구역은 흰 배경으로 두어 대비로 구분한다. */}
    {uc.showRelatedUseCases && (
      <section class="ind-section">
        <div class="ind-container uc-narrow">
          <header class="ind-head"><h2>함께 보면 좋은 과제</h2></header>
          <div class="uc-cases">
            {useCases.filter((u) => u.slug !== uc.slug).map((u) => (
              <a class={u.cardImage ? 'uc-case uc-case--img' : 'uc-case'} href={`/use-cases/${u.slug}`}>
                {u.cardImage && (
                  <img
                    class="uc-case-img"
                    src={u.cardImage.src}
                    alt=""
                    aria-hidden="true"
                    width={u.cardImage.width}
                    height={u.cardImage.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div class="uc-case-body">
                  <span class="uc-case-label">{u.name}</span>
                  <p class="uc-case-desc" set:html={u.cardDesc ?? u.tagline}></p>
                  <span class="uc-case-go" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 -960 960 960" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="m553.85-253.85-42.16-43.38L664.46-450H180v-60h484.46L511.69-662.77l42.16-43.38L780-480 553.85-253.85Z"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class={uc.ctaBackgroundImage ? 'ind-cta uc-cta-bg' : 'ind-cta'}>
      {uc.ctaBackgroundImage && (
        <img
          class="uc-cta-bg-img"
          src={uc.ctaBackgroundImage}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="ind-container">
        <h2 set:html={uc.ctaTitle ?? '우리 현장에 어떻게 적용될지<br>함께 살펴봐요.'}></h2>
        <a href="/contact" class="ind-btn-primary ind-btn-lg">문의하기</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .uc-narrow { max-width: 760px; }
  /* keep-all — 없으면 좁은 화면에서 한국어가 어절 중간에서 잘린다. */
  .uc-problem { font-size: 18px; line-height: 1.8; color: #2b3644; word-break: keep-all; }
  .uc-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .uc-chip {
    font-size: 14px; color: #16202c; background: #fff; border: 1px solid var(--border);
    border-radius: 999px; padding: 8px 16px;
  }
  /* 다른 과제 — 6개를 3열 2행 카드로 둔다. 규격은 위 '이렇게 풉니다' 카드와 같다
     (흰 배경 · 1px 테두리 · radius 12 · padding 24). 링크라 hover를 준다. */
  .uc-cases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  /* 배경 이미지를 꽉 채울 예정이라 세로를 키우고 제목을 아래쪽에 둔다.
     이미지가 들어와도 제목 위치가 그대로라 레이아웃이 흔들리지 않는다.
     position/overflow는 나중에 넣을 이미지가 라운드 모서리 안에 잘리도록 미리 잡아둔 것. */
  .uc-case {
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end;
    min-height: 320px;
    color: #16202c;
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 24px;
    transition: border-color .2s, color .2s, box-shadow .2s;
  }
  /* keep-all — 없으면 한국어가 어절 중간에서 잘린다('흩어/진', '데/이터').
     띄어쓰기에서만 줄을 바꿔 읽는 단위가 유지된다. */
  /* 층 순서: 사진(0) → 어두운 막(1) → 하단 그라데이션(2) → 글(3) */
  .uc-case-body { position: relative; z-index: 3; word-break: keep-all; }
  /* 제목·설명 크기는 랜딩 산업 카드(.industry-name / .industry-desc)와 같은 값. */
  .uc-case-label { display: block; font-size: 20px; font-weight: 600; margin-bottom: 5px; }
  .uc-case-desc { font-size: 15px; line-height: 1.5; color: var(--text-muted); text-wrap: pretty; }
  /* 글자 없이 화살표 아이콘만. 카드 전체가 링크라 이름은 제목이 맡고,
     이 아이콘은 '넘어간다'는 신호만 준다(그래서 aria-hidden). */
  .uc-case-go {
    display: inline-flex; align-items: center; justify-content: center;
    /* 28px — WCAG 2.2 최소 타깃 크기(2.5.8) 하한은 24px이다.
       카드 전체가 링크라 이 아이콘 자체가 타깃은 아니지만,
       24px 아래로 내려가면 1px 테두리와 화살촉 사이 여백이 없어 뭉개진다. */
    width: 28px; height: 28px; margin-top: 20px;
    border: 1px solid currentColor; border-radius: 50%;
    color: #4b86bf;
    transition: transform .2s ease, background-color .2s ease, color .2s ease;
  }
  .uc-case-go svg { display: block; }
  /* hover 시 원이 채워지며 화살표가 뒤집힌 색이 된다. 카드 전체가 링크라
     이동 애니메이션은 그대로 두고 면 채움만 더한다. */
  .uc-case:hover .uc-case-go { transform: translateX(4px); }
  @media (max-width: 860px) {
    .uc-cases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .uc-cases { grid-template-columns: 1fr; }
  }
  .uc-case:hover { border-color: var(--accent); color: #4b86bf; box-shadow: 0 4px 14px rgba(16,32,44,.06); }

  /* 배경 이미지가 있는 카드(데이터에 cardImage를 넣은 것만).
     이미지 → 스크림 → 제목 순으로 쌓아 사진 위에서도 글자가 읽히게 한다.
     테두리를 없애야 이미지가 카드를 끝까지 채운다. 테두리를 두면
     inset:0이 패딩 박스 기준이라 사방 1px씩 흰 테가 남는다. */
  .uc-case-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; pointer-events: none; user-select: none;
    transition: transform .3s ease;
  }
  /* 1층 — 사진 전체를 고르게 덮는 어두운 막. 카드마다 밝기가 제각각인
     사진들의 톤을 한 단계 내려 6장이 같은 계열로 묶이게 한다.
     z-index 필수: ::before는 생성 순서상 .uc-case-img보다 앞이라
     지정하지 않으면 사진이 이 막을 덮어버린다(그리는 순서가 DOM 순서). */
  .uc-case--img::before {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background: rgba(17,19,22,.25);
  }
  /* 2층 — 하단 그라데이션. 글 묶음이 카드의 52~93% 구간에 놓이므로,
     위쪽 절반은 1층 막만 걸리고 그 구간부터 빠르게 짙어지게 한다. */
  .uc-case--img::after {
    content: ''; position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(180deg,
      rgba(17,19,22,0) 0%,
      rgba(17,19,22,.12) 28%,
      rgba(17,19,22,.82) 52%,
      rgba(17,19,22,1) 100%);
  }
  .uc-case--img { border: none; }
  .uc-case--img .uc-case-label { color: #fff; }
  .uc-case--img .uc-case-desc { color: rgba(255,255,255,.82); }
  .uc-case--img .uc-case-go { color: #fff; }
  /* 사진 위에서는 글자색을 바꾸지 않고 이미지를 살짝 확대해 반응을 준다. */
  .uc-case--img:hover .uc-case-label { color: #fff; }
  .uc-case--img:hover .uc-case-img { transform: scale(1.04); }

  .uc-related { margin-top: 26px; font-size: 15px; color: #47535f; }
  .uc-related a { color: #4b86bf; text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }

  /* 템플릿 강조 밴드 — 전력관리·전력품질·공장 에너지관리도 같이 쓰는 공용 스타일이다.
     페이지별로 바꿀 땐 아래 .uc-predictive-maintenance 스코프에서 덮을 것. */
  .uc-template {
    margin-top: 24px; background: #eef5fc; border: 1px solid #cfe0f0; border-radius: 14px;
    padding: 24px 26px;
  }
  /* 알약 없이 아이콘 + 글자만. 면·테두리를 걷어내 밴드 위에 얹힌 라벨로 둔다. */
  .uc-template-badge {
    /* inline-flex면 부모 줄상자(16px·1.65)의 여유 공간이 배지 아래에 붙어
       h3의 margin-top이 화면 간격과 달라진다. flex + fit-content로 줄상자를
       벗어나게 해 선언한 값이 그대로 간격이 되게 한다. */
    display: flex; width: fit-content; align-items: center; gap: 6px;
    /* 크기는 아래 설명(.uc-template p)과 같은 15px. 아이콘도 font-size를 따라 커진다. */
    font-size: 15px; font-weight: 700; letter-spacing: .02em; color: #76a6d7;
    background: none; border: none; border-radius: 0; padding: 0;
  }
  /* 제목·설명 크기는 랜딩 산업 카드(.industry-name / .industry-desc)와 같은 값 —
     위 '이렇게 풉니다' 카드, 아래 '다른 과제' 카드와 한 규격으로 맞춘다.
     목록도 설명과 같은 15px으로 올려 밴드 안에서 글자 크기가 두 종류만 남게 한다. */
  .uc-template h3 { margin-top: 14px; font-size: 20px; font-weight: 600; line-height: 1.6; color: #16202c; }
  .uc-template p { margin-top: 5px; font-size: 15px; line-height: 1.5; color: var(--text-muted); }
  /* 목록은 설명과 성격이 다른 블록이라, 배지→제목(16px)·제목→설명(5px)보다
     넉넉히 띄워 문단이 끝났음을 보인다. */
  .uc-template-list { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 20px; }
  .uc-template-list li { display: flex; align-items: center; gap: 8px; font-size: 15px; color: #16202c; }
  .uc-template-list li i { color: #2f6ba3; font-size: 15px; flex: none; }
  /* 예지보전만 항목이 6개라 3열 2행이 딱 떨어진다.
     나머지(전력관리·전력품질·공장 에너지관리)는 4개여서 3열이면 3+1로 남으므로
     공용 2열 규칙을 그대로 둔다. */
  .uc-predictive-maintenance .uc-template-list { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 860px) {
    .uc-predictive-maintenance .uc-template-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) { .uc-template-list { grid-template-columns: 1fr; } }

  /* ───────────────────────────────────────────────────────────
     아래는 데이터에 해당 필드(heroImage·icon·template.image)를 넣은
     유즈케이스에서만 렌더되는 요소들이다. 넣지 않은 페이지에는 마크업 자체가
     생기지 않으므로 기존 6개 유즈케이스 디자인에는 영향이 없다.
     ─────────────────────────────────────────────────────────── */

  /* 히어로 배경 모드 — 랜딩 #cta와 같은 패턴(절대배치 img + object-fit: cover).
     사진 위에서 글이 읽히도록 어두운 스크림을 덮고 텍스트를 흰색 계열로 바꾼다. */
  .uc-hero-bg { position: relative; overflow: hidden; }
  .uc-hero-bg-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover;
    /* 세로 초점. 값을 낮출수록 사진의 위쪽이 보여 이미지가 아래로 내려간 것처럼 된다
       (0% = 위쪽 끝, 50% = 가운데, 100% = 아래쪽 끝). 섹션 크기·위치는 그대로다. */
    object-position: center 45%;
    pointer-events: none; user-select: none;
  }
  /* 스크림 — 좌측(글이 놓이는 쪽)을 더 진하게 해 대비를 확보한다 */
  /* 사진 위 스크림 — 색은 '푸는 방식' 섹션과 같은 #111316.
     위 80% → 아래 50%로, 태그라인·대제목이 놓인 위쪽을 짙게 덮는다. */
  .uc-hero-bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(17,19,22,.8) 0%, rgba(17,19,22,.5) 100%);
  }
  .uc-hero-bg > .ind-container { position: relative; z-index: 1; }
  .uc-hero-bg h1 { color: #fff; }
  .uc-hero-bg .ind-lede { color: rgba(255,255,255,.82); }
  .uc-hero-bg .ind-crumb, .uc-hero-bg .ind-crumb a { color: rgba(255,255,255,.7); }
  .uc-hero-bg .ind-eyebrow { color: #9cc4e8; }
  /* 어두운 배경용 버튼 — global.css의 #cta .btn-primary와 같은 처리.
     페이지 전용 버튼 규칙(.uc-predictive-maintenance …, 선택자 3개)이 뒤에 선언돼 있어
     같은 우선순위면 그쪽이 이긴다. .uc-page를 붙여 4개로 올린다. */
  .uc-page .uc-hero-bg .ind-hero-actions .ind-btn-ghost {
    color: #fff; border-color: rgba(255,255,255,.6); background: transparent;
  }
  /* 제목이 문장이 되면서 히어로가 빽빽해져 위·사이 여백을 넓힌다
     (공통값은 margin-top 32px · gap 10px). */
  .uc-predictive-maintenance .ind-hero-actions { margin-top: 48px; gap: 16px; }

  /* 주 버튼(문의하기)은 accent 면으로 채워 사진 위에서 먼저 눈에 들어오게 한다. */
  .uc-page .uc-hero-bg .ind-hero-actions .ind-btn-primary {
    background: #76a6d7; color: #fff; border-color: #76a6d7;
  }
  /* 기본이 이미 accent 면이라 hover는 한 단계 어둡게 간다
     (흰 면으로 뒤집으면 보조 버튼 hover와 겹쳐 구분이 사라진다). */
  .uc-page .uc-hero-bg .ind-hero-actions .ind-btn-primary:hover {
    background: #5a8fc5; border-color: #5a8fc5; color: #fff;
  }
  /* 보조 버튼은 흰 면으로 뒤집는다 — 주 버튼(accent 면)과 상태가 겹치지 않는다. */
  .uc-page .uc-hero-bg .ind-hero-actions .ind-btn-ghost:hover {
    background: #fff; border-color: #fff; color: #76a6d7;
  }

  /* 히어로 2컬럼 (heroImage 있을 때만) */
  .uc-hero-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .uc-hero-figure { margin: 0; }
  .uc-hero-figure img {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--border); border-radius: 14px;
    background: #fff; box-shadow: 0 18px 46px rgba(16, 32, 44, 0.10);
  }
  .uc-hero-figure figcaption,
  .uc-template-figure figcaption { margin-top: 10px; font-size: 13px; color: var(--text-muted); }
  @media (max-width: 900px) {
    .uc-hero-row { grid-template-columns: 1fr; gap: 34px; }
  }

  /* 헤더(.nav-inner)와 같은 박스 — 좌측이 로고 선에 정확히 맞는다.
     nav-footer.css의 .nav-inner: max-width 1280 / padding 0 48px, 900px 이하에서 24px. */
  .uc-container--nav { max-width: 1280px; padding: 0 48px; }
  @media (max-width: 900px) {
    .uc-container--nav { padding: 0 24px; }
  }

  /* 히어로를 문의하기 페이지(#contact-hero)와 동일한 크기·위치로 맞춘다.
     contact.css: .container = 1280/48(위 uc-container--nav와 동일),
                  #contact-hero padding-top 180px,
                  h2 = clamp(30px, 4.2vw, 48px) / 600 / -0.8px / 1.3 */
  /* 위 여백 180px은 문의하기 페이지 제목 위치에 맞춘 값이라 건드리지 않는다.
     세로를 키울 땐 아래 여백만 늘려야 제목 위치가 그대로 유지된다. */
  .uc-predictive-maintenance .ind-hero { padding-top: 180px; padding-bottom: 100px; }
  /* 제목이 문장이 되면서 어절이 잘린다('전조 / 를 읽어'). 띄어쓰기에서만 끊는다. */
  .uc-predictive-maintenance .ind-hero h1 { word-break: keep-all; }
  /* 태그라인 — 히어로의 과제명과 '왜 필요한가?' 배지가 같은 형태를 쓴다.
     ind-eyebrow/ind-badge처럼 대문자·자간 확대·알약 배경을 쓰지 않고
     한글 그대로 읽히게 둔다. */
  .uc-tag {
    font-size: 18px; font-weight: 600; letter-spacing: -0.2px;
    /* 하늘색은 배경 밝기와 무관하게 브랜드 값 #76A6D7 하나로 통일한다.
       밝은 배경용 --accent-ink(#4B86BF)·어두운 배경용 #9CC4E8을 쓰지 않는다. */
    color: #76a6d7; margin-bottom: 14px;
  }

  /* 'Refinery는 이렇게 풉니다' 카드를 랜딩 'From Data to Intelligence' 섹션의
     .series-card와 같은 규격으로 맞춘다(색은 이 페이지 것을 유지).
     아이콘을 상자 없이 위에 두고 제목까지 크게 띄우는 것이 그 카드의 특징이다. */
  /* 아이콘~제목 간격. 랜딩 .series-icon은 80px이지만 그 카드는 배경이 거의 검정
     (rgb 17,19,22)이라 빈 공간이 뒤로 물러난다. 이 카드는 흰 배경이라 같은 80px이
     더 넓게 보이므로 65px로 낮춰 보이는 인상을 맞춘다. */
  .uc-card-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: fit-content; height: auto;
    margin-bottom: 65px;
    color: #76a6d7;
  }
  /* 제목을 16 → 20px으로 올린 만큼 아이콘도 키운다(랜딩은 26 / 16). */
  .uc-card-icon i { font-size: 30px; line-height: 1; }
  .uc-predictive-maintenance .ind-card { padding: 24px; }
  /* 제목·설명 크기는 랜딩 산업 카드(.industry-name / .industry-desc)와 같은 값.
     아래 '다른 과제' 카드도 같은 값을 쓰므로 페이지 안 카드 두 묶음이 한 규격이 된다. */
  .uc-predictive-maintenance .ind-card h3 {
    font-size: 20px; font-weight: 600; line-height: 1.6; margin: 0 0 5px;
  }
  .uc-predictive-maintenance .ind-card p { font-size: 15px; line-height: 1.5; margin: 0; }

  /* 템플릿 밴드 2컬럼 (template.image 있을 때만) */
  .uc-template--split { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 34px; align-items: center; }
  .uc-template--split .uc-template-list { grid-template-columns: 1fr; }
  .uc-template-figure { margin: 0; }
  .uc-template-figure img {
    display: block; width: 100%; height: auto;
    border: 1px solid #cfe0f0; border-radius: 12px; background: #fff;
  }
  @media (max-width: 900px) {
    .uc-template--split { grid-template-columns: 1fr; gap: 24px; }
  }

  /* ───────────────────────────────────────────────────────────
     예지보전 전용 — 이 slug 클래스 아래에서만 적용된다.
     ─────────────────────────────────────────────────────────── */

  /* 본문 섹션의 좌우 끝을 헤더(.nav-inner)와 같은 선에 맞춘다 — 로고 왼쪽 = 문의하기 버튼 오른쪽.
     .ind-section만 대상이라 히어로(.ind-hero, 이미 uc-container--nav)와 CTA(.ind-cta)는 제외된다.
     선택자가 .uc-narrow(2개)보다 구체적(3개)이라 좁은 폭 제약도 함께 풀린다. */
  .uc-predictive-maintenance .ind-section .ind-container {
    max-width: 1280px;
    padding: 0 48px;
  }
  /* 섹션 위아래 여백을 랜딩 본문 섹션과 같은 130px으로. (공통값은 84px)
     CTA는 랜딩 #cta와 같은 95px이라 여기서 제외된다(.ind-section이 아님). */
  .uc-predictive-maintenance .ind-section { padding: 130px 0; }
  @media (max-width: 900px) {
    .uc-predictive-maintenance .ind-section { padding: 60px 0; }
  }
  @media (max-width: 900px) {
    .uc-predictive-maintenance .ind-section .ind-container { padding: 0 24px; }
  }

  /* how가 4개라 한 줄에 4개로 둔다(3컬럼이면 마지막 하나가 혼자 떨어진다). */
  .uc-predictive-maintenance .ind-grid-3 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1080px) {
    .uc-predictive-maintenance .ind-grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .uc-predictive-maintenance .ind-grid-3 { grid-template-columns: 1fr; }
  }

  /* 히어로 버튼 2개를 메인 CTA의 '데모 신청하기'와 같은 형태로 통일한다.
     global.css: .btn-primary(밝은 배경용) + #cta .btn-primary(어두운 배경 override).
     CTA는 배경 이미지 위라 흰색 계열이지만 이 히어로는 밝은 배경(#f6f8fa)이므로,
     형태(투명 배경·1px 테두리·radius 6px·9px 22px·15px/400)만 가져오고
     색은 .btn-primary의 밝은 배경용 기본값을 쓴다. hover는 CTA와 동일. */
  .uc-predictive-maintenance .ind-hero-actions .ind-btn-primary,
  .uc-predictive-maintenance .ind-hero-actions .ind-btn-ghost {
    padding: 9px 22px;
    font-size: 15px;
    font-weight: 400;
    background: transparent;
    color: #111111;
    border: 1px solid rgba(17, 17, 17, 0.6);
    border-radius: 6px;
    transition: all .2s;
  }
  .uc-predictive-maintenance .ind-hero-actions .ind-btn-primary:hover,
  .uc-predictive-maintenance .ind-hero-actions .ind-btn-ghost:hover {
    background: #76a6d7;
    border-color: #76a6d7;
    color: #fff;
    transform: none; /* .ind-btn-primary:hover의 translateY 상쇄 */
  }

  /* 큰 제목 3종(히어로·섹션·CTA)의 공통값. 랜딩 섹션 대제목과 같은 clamp 28~45px.
     굵기는 배경에 따라 갈리므로 여기서 정하지 않는다(아래 두 규칙). */
  .uc-predictive-maintenance .ind-hero h1,
  .uc-predictive-maintenance .ind-head h2,
  .uc-predictive-maintenance .ind-cta h2 {
    font-size: clamp(28px, 4vw, 45px);
    letter-spacing: -0.8px;
    line-height: 1.3;
  }
  /* 히어로는 페이지의 첫 제목이라 섹션 제목과 같은 600으로 둔다.
     어두운 배경 위 흰 글자라 실제보다 굵게 보이지만, 그만큼 무게가 실리는 것을 택했다. */
  .uc-predictive-maintenance .ind-head h2 { font-weight: 600; }
  /* 히어로만 500 — 흰 글자가 어두운 사진 위에서 번져 보여 같은 600이어도
     어두운 글자/밝은 배경인 섹션 제목보다 굵게 읽힌다.
     Pretendard가 100 단위 정적 웨이트라 550은 600으로 스냅되므로
     실제로 내려갈 수 있는 단계는 500뿐이다. 크기는 45px로 CTA(40px)보다 크다. */
  .uc-predictive-maintenance .ind-hero h1 { font-weight: 500; }
  /* CTA만 500 — 랜딩 #cta가 섹션 대제목(600)과 다르게 500을 쓰는 것을 따른다. */
  .uc-predictive-maintenance .ind-cta h2 { font-weight: 500; }

  /* '왜 필요한가요?' 섹션 배경. 흰색이던 것을 연회색으로 둬,
     히어로(사진) → 문제(연회색) → 해법(어두움)으로 면이 이어지게 한다. */
  .uc-predictive-maintenance .uc-problem-section { background: #f6f8fa; }

  /* 태그라인을 왼쪽, 본문을 그 오른쪽에 두고 윗선을 맞춘다.
     align-items: start — 두 칸의 높이가 달라도 첫 줄끼리 정렬된다.
     .ind-head의 아래 여백(64px)은 2열에서는 필요 없어 없앤다. */
  .uc-predictive-maintenance .uc-problem-section .ind-container {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .uc-predictive-maintenance .uc-problem-section .ind-head { margin-bottom: 0; }
  /* margin: 0 — .ind-head p가 margin-top 12px를 걸어 태그라인만 12px 내려간다. */
  .uc-predictive-maintenance .uc-problem-section .uc-tag { margin: 0; }
  @media (max-width: 860px) {
    .uc-predictive-maintenance .uc-problem-section .ind-container {
      grid-template-columns: 1fr; gap: 16px;
    }
  }

  /* ───────────────────────────────────────────────────────────
     'Refinery는 이렇게 풉니다' 섹션을 랜딩 'From Data to Intelligence'(#platform)와
     같은 구성으로. 실측값: 섹션·카드 면 #111316, 카드 테두리 #272B32,
     제목 #EDEEF0, 설명 #959CA5, 아이콘 accent.
     카드 면이 섹션 면과 같아서 테두리만으로 구분되는 것이 그 섹션의 특징이다.
     이 페이지에만 적용 — .ind-soft/.ind-card/.uc-template은 다른 유즈케이스도 함께 쓴다.
     ─────────────────────────────────────────────────────────── */
  .uc-predictive-maintenance .ind-soft { background: #111316; }
  .uc-predictive-maintenance .ind-soft .ind-head h2 { color: #edeef0; }
  .uc-predictive-maintenance .ind-soft .ind-card {
    background: #111316; border: 1px solid #272b32;
  }
  /* hover는 랜딩 #integrations의 .rfn-node와 같은 방식 —
     테두리 색을 바꾸지 않고 box-shadow로 2px 링을 덧대고 그림자를 한 단계 키운다.
     레이아웃이 흔들리지 않고, 링크가 아닌 카드에 '누를 수 있다'는 신호도 주지 않는다. */
  .uc-predictive-maintenance .ind-soft .ind-card,
  .uc-predictive-maintenance .uc-template {
    box-shadow: 0 1px 2px rgba(0,0,0,.35), 0 1px 1px rgba(0,0,0,.25);
    transition: box-shadow .15s;
  }
  .uc-predictive-maintenance .ind-soft .ind-card:hover,
  .uc-predictive-maintenance .uc-template:hover {
    box-shadow: 0 0 0 2px #272b32, 0 2px 4px rgba(0,0,0,.35), 0 1px 1px rgba(0,0,0,.25);
  }
  .uc-predictive-maintenance .ind-soft .ind-card h3 { color: #edeef0; }
  .uc-predictive-maintenance .ind-soft .ind-card p { color: #959ca5; }

  /* WISE 밴드도 같은 계열 — 면이 섹션과 같으므로 테두리로 구분한다. */
  /* 밴드가 섹션 배경(#111316)과 같은 색이라 1px 테두리로만 구분됐다.
     오른쪽에서 배어 나오는 하늘색 글로우로 '여기부터 다른 이야기'를 표시한다.
     장식 이미지가 있는 쪽과 방향을 맞춰 빛이 한 곳에서 오는 것처럼 보이게 한다.
     글이 있는 왼쪽은 원래의 #111316이라 대비가 손상되지 않는다. */
  /* 우측 상단 장식 — 글 뒤에 깔린다(.uc-template-body가 z-index로 위).
     그림 바탕이 검정이라 mix-blend-mode: screen으로 어두운 픽셀을 날려
     밴드 배경에 녹인다. 사각 모서리가 드러나지 않는다. */
  .uc-template-deco {
    /* 링 중심을 밴드 밖(우상단)에 두고 바깥 호만 밴드에 걸치게 한다.
       크기와 오프셋을 같은 비율로 묶어 두면 구도는 그대로 두고 스케일만 바뀐다. */
    position: absolute; top: -212px; right: -148px;
    width: 700px; height: auto;
    /* 원본이 투명 PNG라 WebP도 알파를 유지한다. 검정으로 메운 뒤
       mix-blend-mode로 지우는 우회가 필요 없어졌다. */
    opacity: .25;
    /* 우상단에서 멀어질수록 사라진다 — 밴드 좌하단 쪽으로 빛이 옅어진다. */
    -webkit-mask-image: radial-gradient(140% 140% at 100% 0%, #000 55%, transparent 95%);
    mask-image: radial-gradient(140% 140% at 100% 0%, #000 55%, transparent 95%);
    pointer-events: none; user-select: none;
  }
  .uc-template-body { position: relative; z-index: 1; }
  @media (max-width: 860px) { .uc-template-deco { display: none; } }

  /* 위 여백은 4개 카드(.ind-card, 24px)와 같게 둔다 — 배지가 카드의 아이콘과
     같은 자리에서 시작하므로 두 블록의 윗선이 맞는다. */
  .uc-predictive-maintenance .uc-template { padding-top: 24px; }
  /* 배지→제목 간격을 위 4개 카드의 아이콘→제목(65px)과 같게 맞춘다.
     배지가 카드의 아이콘과 같은 자리(묶음 맨 위)에 놓이므로 리듬이 이어진다. */
  .uc-predictive-maintenance .uc-template h3 { margin-top: 65px; }
  .uc-predictive-maintenance .uc-template {
    position: relative; overflow: hidden;
    background:
      linear-gradient(270deg, rgba(118,166,215,.2) 0%, rgba(118,166,215,0) 55%),
      #111316;
    border: 1px solid #272b32;
  }
  .uc-predictive-maintenance .uc-template h3 { color: #edeef0; }
  .uc-predictive-maintenance .uc-template p { color: #959ca5; }
  .uc-predictive-maintenance .uc-template-list li { color: #edeef0; }
  .uc-predictive-maintenance .uc-template-list li i { color: #76a6d7; }

  /* 대제목과 그 아래 내용 사이 간격. 공통값(.ind-head 44px)보다 넓혀
     섹션이 시작되는 지점을 또렷하게 한다. 페이지 안 세 섹션에 같이 적용해
     간격 리듬이 어긋나지 않게 한다. */
  .uc-predictive-maintenance .ind-head { margin-bottom: 64px; }

  /* '왜 필요한가' 본문을 리드 문단처럼 강조 */
  /* 제목(h2)이 생기면서 상자·왼쪽 선이 없어도 구간이 구분된다. 글만 둔다.
     크기·색은 랜딩 섹션 소제목(.section-header p)과 같은 값. */
  .uc-predictive-maintenance .uc-problem {
    font-size: 18px; line-height: 1.7; color: var(--text-muted);
  }
  .uc-predictive-maintenance .uc-narrow { max-width: 820px; }

  /* 제목 행 — 홈 히어로(.hero-row)와 같은 구조: 좌측 제목, 우측 끝 링크, 하단 정렬.
     .ind-head의 max-width(640px)를 풀어야 링크가 컨테이너 우측 끝까지 간다. */
  .uc-head-row {
    max-width: none;
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 32px; flex-wrap: wrap;
  }
  .uc-head-row h2 { margin-bottom: 0; }
  /* global.css의 .hero-demo-link와 같은 표현(18px · hover 시 화살표 이동).
     기본은 옆 대제목과 같은 색이라 한 줄로 붙어 읽히고, 하늘색은 hover에만 쓴다. */
  .uc-more-link {
    display: inline-flex; align-items: center; gap: 8px; flex: none;
    font-size: 18px; font-weight: 400; color: var(--text);
    transition: color .2s ease;
  }
  .uc-more-link:hover { color: #76a6d7; }
  .uc-more-link svg { transition: transform .2s ease; }
  .uc-more-link:hover svg { transform: translateX(4px); }

  /* 신호 카드 — signalsAsCards를 켠 유즈케이스에만 렌더된다.
     아이콘과 텍스트를 세로로 쌓고 가운데 정렬한 사각 카드 4개를
     본문 너비에 1fr씩 나눠 담는다(= 4개가 항상 같은 너비). */
  .uc-signal-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  /* 카드 상자 없이 원형 아이콘과 라벨만 세로로 쌓는다. */
  /* 카드 면색은 'Refinery는 이렇게 풉니다' 섹션 배경(.ind-soft)과 같은 --bg-soft.
     이 섹션은 흰 배경이라 별도 테두리 없이 면색만으로 카드가 구분된다. */
  .uc-signal {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 16px; padding: 32px 20px;
    background: var(--bg-soft); border: none;
    border-radius: var(--radius);
  }
  /* 아이콘 배경 — 80px 원 안에 40px 아이콘(비율 0.5).
     color가 아이콘 stroke(currentColor)로 내려간다. */
  .uc-signal-icon {
    width: 80px; height: 80px; flex: none;
    border-radius: 50%;
    /* 왼쪽 위가 밝고 오른쪽 아래로 짙어지는 대각 그라데이션 —
       평면 채움보다 원이 살짝 떠 보인다. */
    background: linear-gradient(180deg, #76a6d7 0%, #76a6d7 25%, #3f76ae 150%);
    border: none;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
  }
  /* SVG는 stroke가 currentColor라 위 color만 바꾸면 색이 따라온다. */
  .uc-signal-icon i { font-size: 40px; line-height: 1; }
  /* set:html로 주입된 SVG에는 Astro 스코프 속성이 붙지 않으므로 :global이 필요하다.
     (없으면 width/height 없는 SVG가 부모 크기로 늘어난다) */
  /* 획 굵기는 여기서 정한다. SVG 파일의 stroke-width 속성(디자인 원본값 2)보다
     CSS가 우선하고, stroke-width는 상속되므로 도형까지 내려간다.
     → 원본 파일을 고치지 않아도 되고, 다시 내보내 받아도 이 값이 유지된다. */
  .uc-signal-icon :global(svg) {
    width: 40px; height: 40px; display: block;
    stroke-width: 2.2;
  }
  /* 획을 화면 픽셀로 고정한다. 기본값이면 viewBox(50)를 40px로 줄여 그리면서
     획도 함께 줄어(2 → 1.6px), 아이콘 크기를 조정할 때마다 굵기가 딸려 바뀐다.
     non-scaling-stroke를 쓰면 stroke-width 2가 화면에서 그대로 2px이 되고,
     이후 원·아이콘 크기를 바꿔도 획은 2px로 유지된다.
     (상속되지 않는 속성이라 svg가 아니라 도형에 걸어야 한다) */
  .uc-signal-icon :global(svg *) { vector-effect: non-scaling-stroke; }
  /* 카드 대제목(.ind-card h3 / .uc-case-label)과 같은 20px·600. */
  .uc-signal-label { font-size: 20px; font-weight: 600; color: var(--text); line-height: 1.6; }
  @media (max-width: 860px) {
    .uc-signal-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .uc-signal-cards { grid-template-columns: 1fr; }
  }

  /* ───────────────────────────────────────────────────────────
     CTA — 랜딩 #cta와 같은 형태(배경 이미지 위 흰 글자·좌측 정렬).
     데이터에 ctaBackgroundImage를 넣은 유즈케이스에만 적용된다.
     h2에 .uc-page를 덧붙인 이유: Astro가 컴파운드마다 [data-astro-cid]를 붙이므로
     앞의 `.uc-predictive-maintenance .ind-cta h2`가 속성 3개(0,5,1)가 되어
     `.ind-cta.uc-cta-bg h2`(0,4,1)를 이긴다. 한 단계 더 올려 확실히 덮는다.
     ─────────────────────────────────────────────────────────── */
  .uc-cta-bg {
    position: relative; overflow: hidden;
    padding: 95px 0;
    text-align: left;
    /* 글자가 흰색이라 배경은 어둡게 깔아둔다. 이미지가 lazy라 도착 전
       흰 배경이면 글자가 잠깐 보이지 않는다(이미지의 글자 자리 색과 같은 톤). */
    background: #0c1015;
  }
  .uc-cta-bg-img {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    /* 가로는 정확히 꽉 차고(잘림 없음) 세로만 34%가 보인다.
       두 번째 값이 그 띠의 위치 — center면 이미지 한가운데다. */
    object-fit: cover; object-position: center 65%;
    pointer-events: none; user-select: none;
  }
  .uc-cta-bg .ind-container { position: relative; z-index: 1; }
  /* ctaTitle 일부를 다른 색으로 강조하고 싶을 때 쓴다(현재 사용처 없음).
     set:html로 넣은 노드는 Astro 스코프 속성을 받지 않아 :global이 필요하다. */
  .uc-cta-bg h2 :global(.uc-cta-em) { color: #76a6d7; }
  .uc-page .ind-cta.uc-cta-bg h2 {
    /* 랜딩 CTA(45px)보다 한 단계 작다. 유즈케이스는 하위 페이지라 위계가 낮고,
       문구가 더 길며, 버튼이 옆에 붙으면서 제목 폭이 781px로 좁아졌다.
       값은 industry.css의 .ind-cta 기본값과 같다(새 규격을 만들지 않는다). */
    font-size: clamp(26px, 3.6vw, 40px);
    font-weight: 500;
    letter-spacing: -0.8px;
    line-height: 1.35;
    color: #fff;
    margin-bottom: 0;
    text-wrap: initial;
  }
  /* 제목 좌측 · 버튼 우측으로 한 줄에 나눈다. 버튼이 제목 아래에 쌓이지 않아
     시선이 왼쪽 문장에서 오른쪽 행동으로 바로 건너간다.
     가로 위치는 space-between이 잡고(버튼은 오른쪽 끝),
     align-items:center가 세로만 제목 두 줄의 가운데로 맞춘다. */
  .uc-predictive-maintenance .uc-cta-bg .ind-container {
    display: flex; align-items: center; justify-content: space-between;
    gap: 48px; flex-wrap: wrap;
  }
  .uc-predictive-maintenance .uc-cta-bg .ind-container > * { flex: none; }
  /* 한 줄로 나란히 서므로 제목 아래 여백은 필요 없다(줄바꿈되면 아래에서 되돌린다). */
  .uc-predictive-maintenance .uc-cta-bg .ind-btn-primary { margin-top: 0; }
  /* 히어로 '문의하기'와 같은 색 — 투명 면 + 흰 테두리에서 accent 면으로 바꾼다.
     같은 문구·같은 행동이므로 페이지 위아래에서 같은 모습이어야 한다. */
  .ind-cta.uc-cta-bg .ind-btn-primary {
    margin-top: 40px;
    padding: 9px 22px;
    font-size: 15px; font-weight: 400;
    background: #76a6d7; color: #fff;
    border: 1px solid #76a6d7; border-radius: 6px;
    transition: all .2s;
  }
  .ind-cta.uc-cta-bg .ind-btn-primary:hover {
    background: #5a8fc5; border-color: #5a8fc5; color: #fff; transform: none;
  }
  /* 본문 섹션과 같은 선(헤더 로고~버튼)에 맞춘다. */
  .uc-predictive-maintenance .uc-cta-bg .ind-container {
    max-width: 1280px;
    padding: 0 48px;
  }
  @media (max-width: 900px) {
    .uc-predictive-maintenance .uc-cta-bg .ind-container { padding: 0 24px; }
  }
  /* 좁아지면 버튼이 아래로 내려온다. 제목과 붙지 않게 여백을 되살린다. */
  @media (max-width: 780px) {
    .uc-predictive-maintenance .uc-cta-bg .ind-container { gap: 0; }
    .uc-predictive-maintenance .uc-cta-bg .ind-btn-primary { margin-top: 32px; }
  }
