---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/contact.css';
---
<BaseLayout
  title="문의하기 — Refinery"
  description="Refinery 도입 문의, 데모 신청은 여기서 진행해주세요. 담당자가 빠르게 연락드립니다."
  canonical="/contact"
  robots="noindex, follow"
>

<nav>
  <div class="nav-inner">
    <div class="nav-left">
      <a href="/" class="nav-logo"><img src="logo_Refinery_symbol-text.svg" alt="Refinery" style="height:30px;"></a>
      <div class="nav-links">
        <a href="/#platform">Platform</a>
        <a href="/#industries">Industries</a>
        <a href="/#teams">Solutions</a>
        <a href="/#integrations">Integrations</a>
        <a href="/#security">Security</a>
        <a href="/#faq">FAQ</a>
        <a href="/blog">Blog</a>
      </div>
    </div>
    <div class="nav-actions">
      <a href="/" class="btn-primary">홈으로</a>
      <button type="button" class="nav-hamburger" id="navHamburgerBtn" aria-label="메뉴 열기" aria-expanded="false">
        <i class="ph ph-list"></i>
      </button>
    </div>
  </div>
  <div class="mobile-nav-panel" id="mobileNavPanel">
    <a href="/#platform">Platform</a>
    <a href="/#industries">Industries</a>
    <a href="/#teams">Solutions</a>
    <a href="/#integrations">Integrations</a>
    <a href="/#security">Security</a>
    <a href="/#faq">FAQ</a>
    <a href="/" class="mobile-nav-cta">홈으로</a>
  </div>
</nav>
<script is:inline>
  (function() {
    var hamburgerBtn = document.getElementById('navHamburgerBtn');
    var mobileNavPanel = document.getElementById('mobileNavPanel');
    if (!hamburgerBtn || !mobileNavPanel) return;
    function closeMobileNav() {
      mobileNavPanel.classList.remove('open');
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      hamburgerBtn.innerHTML = '<i class="ph ph-list"></i>';
    }
    function openMobileNav() {
      mobileNavPanel.classList.add('open');
      hamburgerBtn.setAttribute('aria-expanded', 'true');
      hamburgerBtn.innerHTML = '<i class="ph ph-x"></i>';
    }
    hamburgerBtn.addEventListener('click', function() {
      if (mobileNavPanel.classList.contains('open')) closeMobileNav();
      else openMobileNav();
    });
    mobileNavPanel.querySelectorAll('a').forEach(function(a) {
      a.addEventListener('click', closeMobileNav);
    });
    window.addEventListener('resize', function() {
      if (window.innerWidth > 900) closeMobileNav();
    });
  })();
</script>

<!-- CONTACT HERO -->
<section id="contact-hero">
  <div class="container">
    <h2>귀사의 현장에 맞는 답을<br>Refinery팀이<br class="contact-title-mobile-br"> 함께 찾아드립니다.</h2>
  </div>
</section>

<!-- CONTACT BODY -->
<section id="contact-body">
  <div class="container">
    <div class="contact-layout">

      <!-- LEFT: info (문의 접수 후 절차 삭제됨, 자리만 유지) -->
      <div class="contact-info-list"></div>

      <!-- RIGHT: form -->
      <div class="contact-form-card">
        <form id="contactForm">
          <input type="hidden" name="access_key" value="c719bd17-006a-44c6-8982-7d281c1f03a7">
          <input type="hidden" name="subject" value="Refinery 웹사이트 문의">
          <input type="hidden" name="from_name" value="Refinery 웹사이트 문의하기">
          <div class="form-row">
            <div class="form-group">
              <label>회사명<span class="req">*</span></label>
              <input type="text" name="company" required>
            </div>
            <div class="form-group">
              <label>성함<span class="req">*</span></label>
              <input type="text" name="name" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>이메일<span class="req">*</span></label>
              <input type="email" name="email" required>
            </div>
            <div class="form-group">
              <label>연락처<span class="req">*</span></label>
              <input type="tel" name="phone" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>직책</label>
              <input type="text" name="position">
            </div>
            <div class="form-group">
              <label>산업 분야</label>
              <select name="industry">
                <option value="">선택해주세요</option>
                <option>에너지 · 유틸리티</option>
                <option>정유 · 가스</option>
                <option>반도체</option>
                <option>철강</option>
                <option>화학 · 정밀화학</option>
                <option>행정</option>
                <option>물류</option>
                <option>총무</option>
                <option>환경</option>
                <option>기타</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>문의 내용</label>
            <textarea id="inquiryTextarea" name="message" placeholder="궁금하신 점이나 현재 겪고 계신 현장의 
어려움을 자유롭게 남겨주세요."></textarea>
          </div>
          <script is:inline>
            (function() {
              var ta = document.getElementById('inquiryTextarea');
              if (!ta) return;
              var mobileText = '궁금하신 점이나 현재 겪고 계신 현장의 ' + String.fromCharCode(10) + '어려움을 자유롭게 남겨주세요.';
              var desktopText = '궁금하신 점이나 현재 겪고 계신 현장의 어려움을 자유롭게 남겨주세요.';
              function updatePlaceholder() {
                ta.placeholder = window.innerWidth <= 900 ? mobileText : desktopText;
              }
              updatePlaceholder();
              window.addEventListener('resize', updatePlaceholder);
            })();
          </script>
          <button type="submit" class="form-submit" id="contactSubmitBtn" disabled>문의 보내기</button>
        </form>
        <div class="form-success" id="formSuccess">
          <i class="ph ph-check-circle"></i>
          <h3>문의가 접수되었습니다</h3>
          <p>담당자가 확인 후 1~2 영업일 내 연락드리겠습니다.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="logo_Refinery_symbol.svg" alt="Refinery" style="height:36px;">
        <p>Refining complexity<br>into pure insight</p>
      </div>
      <div>
        <div class="footer-col-title">Product</div>
        <div class="footer-links"><a href="/#platform">Platform</a><a href="/#industries">Industries</a><a href="/#teams">Solutions</a><a href="/#integrations">Integrations</a></div>
      </div>
      <div>
        <div class="footer-col-title">Trust</div>
        <div class="footer-links"><a href="/#security">Security</a><a href="/#faq">FAQ</a></div>
      </div>
      <div>
        <div class="footer-col-title">Company</div>
        <div class="footer-links"><a href="/company">회사 소개</a><a href="/#cta">Contact Sales</a><a href="/blog">Blog</a></div>
      </div>
    </div>

