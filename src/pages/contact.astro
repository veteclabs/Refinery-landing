    <div class="footer-bottom">
      <div class="footer-bottom-text">© <span id="footerYear">2026</span> VETEC. All rights reserved.</div>
    <script is:inline>(function(){var y=document.getElementById('footerYear'); if(y) y.textContent = new Date().getFullYear();})();</script>
    </div>
